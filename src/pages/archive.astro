---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="mood studies archive">
  <button
    slot="header-actions"
    id="view-btn"
    class="view-btn"
    type="button"
    aria-label="Switch archive view"
  >
    <span aria-hidden="true">view</span>
  </button>
  <section class="archive-header">
    <h2>archival index</h2>
  </section>

  <section class="archive-list" data-view="images">
    <ul>
      <li>
        <a href="/studies/001">
          <img
            src="/images/studies/001/inkblot_001_white.png"
            alt="Rorschach inkblot"
          />
          <span class="mobile-study-button">[ mood study 001: Sofiya V ]</span>

          <span class="study-label"><h3>001 — Sofiya V</h3> </span>
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .mobile-study-button {
    display: block;
    width: fit-content;
    margin: 1.5rem auto 0;
    font-family: var(--font-syne-mono);
    font-size: 0.9rem;
    color: var(--accent);
  }

  .archive-header {
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 2rem;
  }

  .archive-list ul {
    display: grid;
    grid-template-columns: 1fr;
    justify-content: center;
    gap: 3rem;
    margin: 0;
    padding: 0;
  }

  .archive-list li {
    display: flex;
    justify-content: center;
    list-style: none;
  }

  .archive-list a {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .study-label {
    display: none;
  }

  /* Text view */

  .archive-list[data-view="text"] li {
    justify-content: flex-start;
  }

  .archive-list[data-view="text"] img {
    display: none;
  }

  .archive-list[data-view="text"] .study-label {
    display: block;
  }
  .archive-list[data-view="text"] .mobile-study-button {
    display: none;
  }
  .archive-list ul[data-view="images"] {
    grid-template-columns: repeat(auto-fit, 200px);
    justify-content: center;
    gap: 3rem 6rem;
  }

  .archive-list ul[data-view="text"] {
    grid-template-columns: repeat(auto-fit, 200px);
    justify-content: center;
    gap: 3rem 6rem;
  }

  /* img view */
  .archive-list img {
    display: block;
    width: 100%;
    max-width: 200px;
    height: auto;
    margin-inline: auto;
  }

  .archive-list[data-view="images"] a {
    transition:
      filter 0.2s ease,
      transform 0.2s ease;
  }

  .archive-list[data-view="images"] a:hover {
    filter: drop-shadow(0 0 5px var(--accent));
    transform: scale(1.03);
  }

  .archive-list[data-view="images"] a:active img {
    transform: translateY(2px) scale(0.98);
    filter: brightness(0.85);
  }

  .archive-list[data-view="text"] a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-shadow: 0 0 2px var(--accent);
  }

  @media (min-width: 768px) {
    .archive-list[data-view="images"] .mobile-study-button {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .archive-list[data-view="text"] ul {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .archive-list[data-view="text"] li {
      width: 100%;
      border-bottom: 1px solid var(--muted);
    }

    .archive-list[data-view="text"] li:first-child {
      border-top: 1px solid var(--muted);
    }

    .archive-list[data-view="text"] a {
      display: block;
      width: 100%;
      padding: 1rem;
      transition:
        transform 0.08s ease,
        background 0.08s ease;
    }

    .archive-list[data-view="text"] a:active {
      background: var(--accent);
      color: var(--bg);
    }

    .archive-list[data-view="text"] .study-label {
      width: 100%;
    }

    .archive-list[data-view="text"] h3 {
      margin: 0;
      font-size: 1rem;
      font-weight: normal;
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>("#view-btn");
  const archive = document.querySelector<HTMLElement>(".archive-list");

  button?.addEventListener("click", () => {
    if (!archive) return;

    const showingImages = archive.dataset.view === "images";
    const nextView = showingImages ? "text" : "images";

    archive.dataset.view = nextView;
    button.setAttribute("aria-pressed", String(showingImages));
    button.setAttribute(
      "aria-label",
      showingImages ? "Switch to image view" : "Switch to text view",
    );
  });
</script>
