---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allStudies = await getCollection("studies");
const studies = allStudies
  .sort((b, a) => a.data.studyNumber.localeCompare(b.data.studyNumber))
  .map((entry) => ({
    studyNumber: entry.data.studyNumber,
    artist: entry.data.artist,
    date: entry.data.date,
    duration: entry.data.duration,
    observation: entry.data.observation,
    href: `/studies/${entry.id}`,
  }));
---

<BaseLayout
  title="mood studies archive"
  summary="Field notes from the in-between."
>
  <div class="archive">
    <header class="archive-header">
      <h1>archival index</h1>
      <div class="header-rule" aria-hidden="true"></div>
    </header>

    <ol class="ledger">
      {
        studies.map((study) => {
          const panelId = `observation-${study.studyNumber}`;

          return (
            <li class="record">
              <div class="record-row">
                <span class="figure-number">Fig. {study.studyNumber}</span>

                <div class="record-identity">
                  <a class="artist-link" href={study.href}>
                    {study.artist}
                  </a>
                </div>
                <span class="date">{study.date}</span>

                <span class="duration">{study.duration}</span>

                <button
                  class="observe-button"
                  type="button"
                  aria-expanded="false"
                  aria-controls={panelId}
                >
                  <span class="observe-label">+ note</span>
                </button>
              </div>

              <div class="observation" id={panelId} aria-hidden="true">
                <div class="observation-clip">
                  <article class="observation-inner">
                    <p class="observation-text">
                      <i>{study.observation}</i>
                    </p>
                    <a class="machine-link" href={study.href}>
                      open &gt;&gt;&gt;
                    </a>
                  </article>
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .archive {
    width: min(calc(100% - 2rem), 1120px);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 9vw, 8rem);
    color: var(--text, #e3e5de);
  }

  .archive-header {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .ledger {
    margin: 0;
    padding: 0;
  }

  .record {
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--light) 48%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--light) 48%, transparent);
  }

  .record-row {
    display: grid;
    grid-template-columns: auto auto auto auto auto;
    gap: clamp(1rem, 3vw, 3rem);
    align-items: center;
    min-height: 7rem;
    padding: 1.25rem 0.5rem;
  }

  .record-row:hover {
    background-color: color-mix(in srgb, var(--glow) 20%, transparent);
  }

  .figure-number,
  .duration,
  .date {
    font-family: monospace;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }

  .record-identity {
    display: grid;
    gap: 0.35rem;
  }

  .artist-link {
    width: fit-content;
    color: var(--text, #e3e5de);
    font-family: monospace;
    text-transform: uppercase;
    font-size: clamp(0.8rem, 2vw, 1rem);
    line-height: 1;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .artist-link:hover,
  .artist-link:focus-visible {
    color: var(--glow-bright, #d1f5d5);
    text-shadow: 0 0 7px color-mix(in srgb, var(--glow) 55%, transparent);
  }

  .observe-button {
    justify-self: end;
    min-width: 8rem;
    min-height: 2.75rem;
    padding: 0.55rem 0.75rem;
    border: 0;
    background: transparent;
    color: var(--glow);
    font-family: var(--machine-text), monospace;
    font-size: 0.64rem;
    cursor: pointer;
  }

  .observe-button::before,
  .observe-button::after {
    color: currentColor;
  }

  .observe-button::before {
    content: "[ ";
  }

  .observe-button::after {
    content: " ]";
  }

  .observe-button:hover,
  .observe-button:focus-visible,
  .observe-button[aria-expanded="true"] {
    color: var(--glow-bright, #d1f5d5);
    text-shadow: 0 0 6px var(--glow, #a9d9b0);
  }

  .observe-button:focus-visible {
    outline: 1px dotted var(--glow-bright, #d1f5d5);
    outline-offset: 2px;
  }

  .observe-button[aria-expanded="true"] .observe-label {
    font-size: 0;
  }

  .observe-button[aria-expanded="true"] .observe-label::after {
    content: "- note";
    font-size: 0.64rem;
  }

  .observation {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 520ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 520ms;

    font-weight: thin;
  }

  .observation[aria-hidden="false"] {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 520ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s;
  }

  .observation-clip {
    min-height: 0;
    overflow: hidden;
  }

  .observation-inner p {
    position: relative;
    min-height: clamp(5rem, 42vw, 10rem);
    border-top: 1px solid color-mix(in srgb, var(--light) 35%, transparent);
    max-width: 48rem;
    margin: 0;
    color: var(--light);
    font-family: serif;
    font-size: clamp(0.8rem, 2.6vw, 1rem);
    line-height: 1.55;
  }

  .observation-inner a span {
    color: color-mix(in srgb, var(--text, #e3e5de) 63%, transparent);
    font-family: monospace;
    font-size: 0.9rem;
  }

  @media (max-width: 720px) {
    .archive {
      width: 100%;
    }

    .archive-header,
    .record-row,
    .observation-inner {
      padding-inline: 1rem;
    }

    .record-row {
      grid-template-columns: 4.5rem 1fr auto;
      gap: 0.8rem;
      min-height: 6rem;
    }

    .record-description {
      font-size: 0.82rem;
    }

    .observe-button {
      min-width: auto;
      padding-inline: 0.25rem;
    }

    .observe-label {
      font-size: 0;
    }

    .observe-label::after {
      content: "+";
      font-size: 0.8rem;
    }

    .observe-button[aria-expanded="true"] .observe-label::after {
      content: "−";
      font-size: 0.8rem;
    }

    .observation-copy > p {
      font-size: 1.25rem;
    }

    .observation-copy footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .annotation {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .observation {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const controls =
    document.querySelectorAll<HTMLButtonElement>(".observe-button");

  const setOpen = (control: HTMLButtonElement, open: boolean) => {
    const panelId = control.getAttribute("aria-controls");
    const panel = panelId ? document.getElementById(panelId) : null;

    control.setAttribute("aria-expanded", String(open));
    panel?.setAttribute("aria-hidden", String(!open));
  };

  controls.forEach((control) => {
    control.addEventListener("click", () => {
      const willOpen = control.getAttribute("aria-expanded") !== "true";

      controls.forEach((otherControl) => {
        setOpen(otherControl, otherControl === control && willOpen);
      });
    });
  });
</script>
