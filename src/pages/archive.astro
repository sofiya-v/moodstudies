---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allStudies = await getCollection("studies");

// Sort entries by date descending (newest first)
const studies = allStudies
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .map((entry) => ({
    studyNumber: entry.data.studyNumber,
    artist: entry.data.artist,
    date: entry.data.date,
    duration: entry.data.duration,
    observation: entry.data.observation,
    href: `/studies/${entry.id}`,
  }));
---

<BaseLayout
  title="mood studies index"
  summary="Field notes from the in-between."
>
  <div class="split-ledger" data-split-ledger>
    {/* Left Column: Fixed / Scrollable Index */}
    <aside class="ledger-index">
      <header class="ledger-header">
        <h1>index</h1>
        <span class="ledger-count">{studies.length} entries</span>
      </header>

      <ul class="ledger-list" role="list">
        {
          studies.map((study, index) => (
            <li class="ledger-item">
              <a
                href={study.href}
                class="ledger-link"
                class:list={[{ active: index === 0 }]}
                data-ledger-trigger
                data-target-index={index}
              >
                <span class="item-num">{study.studyNumber}</span>
                <span class="item-artist">{study.artist}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </aside>

    {/* Right Column: Pinned Active Fragment Stage */}
    <main class="fragment-stage">
      {
        studies.map((study, index) => (
          <article
            class="fragment-card"
            data-fragment-card
            data-index={index}
            hidden={index !== 0}
          >
            <div class="fragment-meta">
              <span class="meta-label">mood study {study.studyNumber}</span>
              <span class="meta-divider">—</span>
              <span class="meta-date">{study.date}</span>
            </div>

            <h2 class="fragment-artist">{study.artist}</h2>

            <p class="fragment-text">{study.observation}</p>

            <div class="fragment-action">
              <a href={study.href} class="machine-link">
                open &gt;&gt;
              </a>
            </div>
          </article>
        ))
      }
    </main>
  </div>
</BaseLayout>

<style>
  /* --- LAYOUT STRUCTURE --- */

  .split-ledger {
    width: min(calc(100% - 3rem), 1100px);
    margin-inline: auto;
    min-height: 100dvh;
    padding-block: clamp(4rem, 8vw, 8rem);
    display: grid;
    grid-template-columns: minmax(240px, 1fr) 1.5fr;
    gap: clamp(2.5rem, 5vw, 6rem);
    align-items: start;
  }

  /* --- LEFT COLUMN: LEDGER INDEX --- */

  .ledger-index {
    position: sticky;
    top: clamp(4rem, 8vw, 8rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .ledger-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--text, #e3e5de) 15%, transparent);
  }

  .ledger-header h1 {
    margin: 0;
  }

  .ledger-count {
    font-family: var(--machine-text, monospace);
    font-size: 0.8rem;
    opacity: 0.4;
  }

  .ledger-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .ledger-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.5rem 0;
    color: var(--text, #e3e5de);
    text-decoration: none;
    opacity: 0.4;
    transition: opacity 150ms ease;
  }

  .ledger-link:hover,
  .ledger-link:focus-visible,
  .ledger-link.active {
    opacity: 1;
  }

  .item-num {
    font-family: var(--machine-text, monospace);
    font-size: 0.8rem;
    opacity: 0.6;
  }

  .item-artist {
    font-size: 1rem;
    font-weight: 300;
    font-family: Arial, Helvetica, sans-serif;
  }

  /* --- RIGHT COLUMN: FRAGMENT STAGE --- */

  .fragment-stage {
    position: sticky;
    top: clamp(4rem, 8vw, 8rem);
    min-height: 20rem;
    display: flex;
    align-items: flex-start;
  }

  .fragment-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    width: 100%;
  }

  .fragment-card[hidden] {
    display: none !important;
  }

  .fragment-meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--machine-text, monospace);
    font-size: 0.8rem;
    color: var(--light, #e3e5de);
    text-transform: uppercase;
    opacity: 0.5;
  }

  .fragment-artist {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 300;
    color: var(--text, #e3e5de);
  }

  .fragment-text {
    margin: 0;
    color: var(--light, #e3e5de);
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    font-weight: 300;
    line-height: 1.6;
    opacity: 0.85;
    max-width: 34rem;
  }

  /* --- RESPONSIVE ADJUSTMENTS --- */

  @media (max-width: 768px) {
    .split-ledger {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-block: 3rem 4rem;
    }

    .ledger-index,
    .fragment-stage {
      position: relative;
      top: 0;
    }

    .fragment-stage {
      min-height: auto;
      border-top: 1px solid
        color-mix(in srgb, var(--text, #e3e5de) 15%, transparent);
      padding-top: 2rem;
    }
  }
</style>

<script>
  function initSplitLedger() {
    const container = document.querySelector<HTMLElement>(
      "[data-split-ledger]",
    );
    if (!container || container.dataset.initialized === "true") return;
    container.dataset.initialized = "true";

    const triggers = Array.from(
      container.querySelectorAll<HTMLElement>("[data-ledger-trigger]"),
    );
    const cards = Array.from(
      container.querySelectorAll<HTMLElement>("[data-fragment-card]"),
    );

    function activateIndex(targetIdx: number) {
      triggers.forEach((trigger) => {
        const idx = Number(trigger.dataset.targetIndex);
        trigger.classList.toggle("active", idx === targetIdx);
      });

      cards.forEach((card) => {
        const idx = Number(card.dataset.index);
        card.hidden = idx !== targetIdx;
      });
    }

    triggers.forEach((trigger) => {
      const targetIdx = Number(trigger.dataset.targetIndex);

      // Hover / Focus updates the preview on the right
      trigger.addEventListener("mouseenter", () => activateIndex(targetIdx));
      trigger.addEventListener("focus", () => activateIndex(targetIdx));
    });
  }

  initSplitLedger();
  document.addEventListener("astro:page-load", initSplitLedger);
</script>
