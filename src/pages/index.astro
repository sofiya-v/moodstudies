---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ticker from "../components/Ticker.astro";

const observations = [
  "the blue hour is now",
  "reports of mutual dreaming are unverified but seductively plausible",
  "pay special attention to vespertine phenomena",
  "as below, so above",
  "memories wither and bloom in the waters of time",
  "you've been here before",
  "haven't you?",
  "your stay will be short but its effects will linger",
  "the archive changes as it's observed",
  "you will intuit your way through",
  "try to remember what you've found",
  "there are dark times in which things glow",
  "your demeanor is an incantation",
  "glittering images must be studied",
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <BaseLayout>
      <Ticker items={observations} />
      <section class="title">
        <h1 aria-label="mood studies">
          <span aria-hidden="true">mood studies</span>
        </h1>
        <h5>
          <a class="archival-index" href="/archive">[ enter ]</a>
        </h5>
      </section>
    </BaseLayout>
  </body>
</html>
<style>
  .title {
    min-height: 70svh;
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    text-align: center;
  }

  .title h1 {
    grid-row: 2;
    margin: 0;
    align-self: center;
  }

  .title h5 {
    grid-row: 3;
    margin: 0;
    align-self: end;
  }

  .title span {
    display: block;
    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.06em;
    color: var(--fg);
    text-shadow: 0 0 3px var(--accent);
    font-size: 3rem;
  }
  .archival-index {
    text-decoration: none;
    font-family: var(--font-syne-mono);
    font-size: 1.2rem;
    text-shadow: 0 0 1px var(--accent);
  }

  .archival-index:hover {
    color: var(--accent);
  }

  .archival-index:active {
    color: var(--accent);
    text-shadow: 0 0 4px var(--accent);
    transform: translateY(2px);
  }

  @media (prefers-reduced-data: reduce) {
    .video-container {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .bg-video {
      min-width: 150%;
    }
  }
</style>
