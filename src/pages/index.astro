---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ticker from "../components/Ticker.astro";
import { Font } from "astro:assets";

const observations = [
  "the blue hour is now",
  "reports of mutual dreaming are unverified but seductively plausible",
  "pay special attention to vespertine phenomena",
  "as below, so above",
  "memories wither and bloom in the waters of time",
  "you've been here before",
  "haven't you?",
  "your stay will be short but its effects will linger",
  "the archive changes as it's observed",
  "you will intuit your way through",
  "try to remember what you've found",
  "there are dark times in which things glow",
  "your demeanor is an incantation",
  "glittering images must be studied",
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <BaseLayout>
      <Ticker items={observations} />
      <section class="title">
        <h1 aria-label="mood studies">
          <span aria-hidden="true">mood studies</span>
        </h1>
        <h5>
          <a class="archival-index" href="/archive">[ archival index ]</a>
        </h5>
      </section>
    </BaseLayout>
  </body>
</html>
<style>
  .title {
    min-height: 70svh;
    display: grid;
    place-items: center;
    text-align: center;
  }

  .title span {
    display: block;
    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.06em;
    color: var(--fg);
  }
  .archival-index {
    text-decoration: none;
    font-family: var(--font-syne-mono);
    font-size: 1.2rem;
  }

  .archival-index:hover {
    color: var(--accent);
  }

  @media (prefers-reduced-data: reduce) {
    .video-container {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .bg-video {
      min-width: 150%;
    }
  }
</style>
