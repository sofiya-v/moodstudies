---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ticker from "../components/Ticker.astro";

const observations = [
  "the blue hour is now",
  "please enjoy the twilit hush",
  "pay special attention to vespertine phenomena",
  "reports of mutual dreaming are unverified but seductively plausible",
  "as below, so above",
  "beware of your memories as they wither and bloom in the waters of time",
  "you've been here before",
  "your stay will be brief but its effects will linger",
  "the archive changes as it's observed",
  "you will intuit your way through",
  "try to remember what you've found",
  "there are dark times in which things glow",
  "your demeanor is an incantation",
  "the study of glittering images is a worthy pursuit",
];
---

<BaseLayout>
  <div class="page">
    <Ticker items={observations} />
    <h1 aria-label="mood studies">
      <span aria-hidden="true">mood studies</span>
    </h1>
    <a class="machine-link" href="/archive"> &gt; ENTER &lt; </a>
  </div>

  <style>
    .main-nav {
      visibility: hidden;
    }

    .page {
      box-sizing: border-box;
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: space-evenly;
      align-items: center;
      overflow: hidden;
      position: fixed;
      inset: 0;
      width: min(100%, 48rem);
      margin-inline: auto;
    }

    .page:has(.machine-link:hover) :global(.ticker-track),
    .page:has(.machine-link:hover) :global(.ticker-item) {
      animation-play-state: paused;
    }

    a#archival-index {
      font-family: var(--machine-text);
      text-decoration: none;
      font-size: clamp(1rem, 2vw, 1.2rem);
      text-shadow:
        0 0 2px #fff,
        0 0 8px rgba(0, 255, 200, 0.95),
        0 0 22px rgba(0, 255, 200, 0.5);
    }

    a#machine-link:hover {
      color: var(--dark);
      background: var(--glow);
      text-shadow: none;
      box-shadow: 0 0 8px color-mix(in srgb, var(--glow) 45%, transparent);
    }

    @media (max-width: 768px) {
      .page img {
        width: clamp(12rem, 55vw, 18rem);
        max-height: 32svh;
      }

      a#archival-index {
        font-size: 0.8rem;
      }
    }
  </style>
</BaseLayout>
