---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ticker from "../components/Ticker.astro";

const observations = [
  "the blue hour is now",
  "reports of mutual dreaming are unverified but seductively plausible",
  "pay special attention to vespertine phenomena",
  "as below, so above",
  "beware of your memories as they wither and bloom in the waters of time",
  "you've been here before",
  "your stay will be brief but its effects will linger",
  "the archive changes as it's observed",
  "you will intuit your way through",
  "try to remember what you've found",
  "there are dark times in which things glow",
  "your demeanor is an incantation",
  "the study of glittering images is a worthy pursuit",
];
---

<BaseLayout>
  <div class="page">
    <Ticker items={observations} />
    <h1 aria-label="mood studies">
      <span aria-hidden="true">mood studies</span>
    </h1>
    <a id="archival-index" href="/archive">&gt;&gt; enter &lt;&lt;</a>
  </div>

  <style>
    .page {
      box-sizing: border-box;
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: space-evenly;
      align-items: center;
      overflow: hidden;
      position: fixed;
      inset: 0;
      width: min(100%, 48rem);
      margin-inline: auto;
    }

    a#archival-index {
      font-family: var(--font-silkscreen);
      text-decoration: none;
      font-size: clamp(1rem, 2vw, 1.2rem);
    }

    a#archival-index:hover {
      color: white;
      text-shadow:
        0 0 4px rgba(255, 255, 255, 1),
        0 0 10px rgba(0, 255, 200, 0.8),
        /* Intense inner color */ 0 0 10px rgba(0, 255, 200, 0.6),
        /* Mid-range spread */ 3px 5px 5px rgba(0, 0, 0, 0.7);
      transform: scale(1.3);
    }

    a#archival-index:active {
      transform: translateY(2px);
    }

    @media (max-width: 768px) {
      .page img {
        width: clamp(12rem, 55vw, 18rem);
        max-height: 32svh;
      }

      a#archival-index {
        font-size: 0.8rem;
      }
    }
  </style>
</BaseLayout>
