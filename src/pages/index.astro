---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ticker from "../components/Ticker.astro";

const observations = [
  "the blue hour is now",
  "reports of mutual dreaming are unverified but seductively plausible",
  "you've seen things you can't explain",
  "as below, so above",
  "memories wither and bloom in the waters of time",
  "you've been here before",
  "haven't you?",
  "your stay will be short but its effects will linger",
  "the archive changes as it's observed",
  "you will intuit your way through",
  "try to remember what you've found",
  "there are dark times in which things glow",
  "your demeanor is an incantation",
  "glittering images must be studied",
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <BaseLayout>
      <section class="title">
        <h1 aria-label="mood studies">
          <span aria-hidden="true">mood studies</span>
        </h1>
        <h5><a href="/archive">archival index</a></h5>
      </section>
      <Ticker items={observations} />
    </BaseLayout>
  </body>
</html>
<style>
  .title {
    min-height: 70svh;
    display: grid;
    place-items: center;
    text-align: center;
  }

  .title h1 {
    margin: 0;
    perspective: 800px;
    font-family: var(--font-sans);
  }

  .title span {
    display: block;
    font-size: clamp(4rem, 20vw, 11rem);
    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.08em;

    color: var(--fg);
  }
</style>
