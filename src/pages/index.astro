---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ticker from "../components/Ticker.astro";

const observations = [
  "the blue hour is now",
  "reports of mutual dreaming are unverified but seductively plausible",
  "pay special attention to vespertine phenomena",
  "as below, so above",
  "memories wither and bloom in the waters of time",
  "you've been here before",
  "haven't you?",
  "your stay will be short but its effects will linger",
  "the archive changes as it's observed",
  "you will intuit your way through",
  "try to remember what you've found",
  "there are dark times in which things glow",
  "your demeanor is an incantation",
  "the study of glittering images is a worthy pursuit",
];
---

<BaseLayout>
  <div class="page">
    <Ticker items={observations} />
    <img src="/images/cherub.png" alt="golden cherub trinket" />
    <h1 aria-label="mood studies">
      <span aria-hidden="true">mood studies</span>
    </h1>
    <h5>
      <a id="archival-index" href="/archive">&gt;&gt; enter &lt;&lt;</a>
    </h5>
  </div>

  <style>
    .page {
      box-sizing: border-box;
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: space-evenly;
      align-items: center;
      overflow: hidden;
      position: fixed;
      inset: 0;
      width: min(100%, 48rem);
      margin-inline: auto;
    }

    .page img {
      width: clamp(8rem, 25vw, 16rem);
      max-height: 28svh;
      object-fit: contain;
    }
    a {
      display: inline-block;
      color: var(--fg);
      text-decoration: none;
      font-family: var(--font-silkscreen);
      font-size: 1.2rem;
      text-shadow: 0 0 1px var(--glow);
      transition:
        transform 200ms ease,
        color 200ms ease;
      transform-origin: center;
    }

    a:hover {
      color: var(--glow);
      text-shadow: 0 0 2px var(--glow);
      transform: scale(1.3);
    }

    a:active {
      color: var(--glow);
      text-shadow: 0 0 4px var(--glow);
      transform: translateY(2px);
    }

    @media (max-width: 768px) {
      .img {
        width: clamp(12rem, 55vw, 18rem);
        max-height: 32svh;
      }
    }
  </style>
</BaseLayout>
