---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="how strange...">
  <div class="not-found">
    <h1>404</h1>
    <img
      src="/images/crying eye.png"
      alt="golden trinket resembling an eye with a teardrop"
    />
    <p class="copy">...you find yourself in a place that does not exist.</p>
  </div>
</BaseLayout>

<style>
  /* This stylesheet is loaded only on the 404 page. */
  :global(.bg-video-web),
  :global(.mobile-film-glow),
  :global(.mobile-film-original) {
    filter: grayscale(1) brightness(0.48) contrast(0.85) blur(2px) !important;
  }

  :global(.mobile-film) {
    background: #050505;
  }

  .not-found {
    box-sizing: border-box;
    min-height: 100svh;
    padding: 8rem 1.5rem 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    text-align: center;
  }

  h1 {
    margin: 0 0 2.5rem;
    font-size: clamp(2.8rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1;
    color: #b7b7b5;
    text-shadow: 0 0 14px rgba(210, 210, 210, 0.14);
    letter-spacing: 0.09em;
  }

  img {
    display: block;
    width: auto;
    max-width: min(70vw, 390px);
    height: auto;
    max-height: 38svh;
    object-fit: contain;
    filter: saturate(0.75) brightness(0.87);
  }

  .copy {
    max-width: 32rem;
    margin: 3.5rem 0 0;
    color: #b2b2b0;
    line-height: 1.5;
    text-shadow: none;
  }

  @media (max-width: 768px) {
    .not-found {
      min-height: calc(100svh - 5rem);
      padding: 4rem 1.5rem 5rem;
    }

    h1 {
      margin-bottom: 2rem;
    }

    img {
      max-width: 80vw;
      max-height: 34svh;
    }

    .copy {
      margin-top: 2.5rem;
    }
  }
</style>
