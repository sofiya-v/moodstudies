---
import { getCollection, render, type CollectionEntry } from "astro:content";
import StudyLayout from "../../layouts/StudyLayout.astro";

export async function getStaticPaths() {
  const allStudies = await getCollection("studies");

  return allStudies.map((study: CollectionEntry<"studies">) => {
    return {
      params: { id: study.data.studyNumber }, // Matches "001", "002", etc. directly
      props: { study },
    };
  });
}

const { study } = Astro.props;

const { Content } = await render(study);
---

<StudyLayout
  studyNumber={study.data.studyNumber}
  artist={study.data.artist}
  trackId={study.data.trackId}
  blueHourSrc={study.data.blueHourSrc}
  blueHourMetadata={study.data.blueHourMetadata}
  inkblot1Src={study.data.inkblot1Src}
  inkblot1Response={study.data.inkblot1Response}
  qResponse1={study.data.qResponse1}
  qResponse2={study.data.qResponse2}
  qResponse3={study.data.qResponse3}
  dreamImageSrc={study.data.dreamImageSrc}
  dreamImageAlt={study.data.dreamImageAlt}
  trinketSrc={study.data.trinketSrc}
  trinketAlt={study.data.trinketAlt}
>
  <fragment slot="bio">{study.data.bio} </fragment>

  <fragment slot="dream-log">
    <Content />
  </fragment>

  <fragment slot="caption">
    {study.data.caption.label}
    <a href={study.data.caption.authorUrl}>{study.data.caption.author}</a>
  </fragment>
</StudyLayout>
