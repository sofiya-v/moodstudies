---
import { getCollection, render, type CollectionEntry } from "astro:content";
import StudyLayout from "../../layouts/StudyLayout.astro";

export async function getStaticPaths() {
  const studies = await getCollection("studies");

  return studies.map((study: CollectionEntry<"studies">) => ({
    params: {
      id: study.data.studyNumber,
    },
    props: {
      study,
    },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<StudyLayout
  studyNumber={study.data.studyNumber}
  artist={study.data.artist}
  trackId={study.data.trackId}
  date={study.data.date}
  duration={study.data.duration}
  bio={study.data.bio}
  blueHourSrc={study.data.blueHourSrc}
  blueHourCaption={study.data.blueHourCaption}
  blueHourAlt={study.data.blueHourAlt}
  inkblotSrc={study.data.inkblotSrc}
  inkblotResponse={study.data.inkblotResponse}
  qResponse1={study.data.qResponse1}
  qResponse2={study.data.qResponse2}
  qResponse3={study.data.qResponse3}
  dreamImageSrc={study.data.dreamImageSrc}
  dreamImageAlt={study.data.dreamImageAlt}
  trinketSrc={study.data.trinketSrc}
  trinketAlt={study.data.trinketAlt}
  caption={study.data.caption}
>
  <Content />
</StudyLayout>
