---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const audioFiles = import.meta.glob(
  "/src/assets/audio/*.{mp3,flac,wav,ogg,m4a}",
  { eager: true, query: "?url", import: "default" },
);

const playlist = Object.entries(audioFiles).map(([path, fileUrl]) => ({
  src: fileUrl as string,
  title: path.split("/").pop() || "",
}));

const allSightings: CollectionEntry<"sightings">[] =
  await getCollection("sightings");
const sightings = [...allSightings].sort(() => Math.random() - 0.5);

const passages = await getCollection("fragments");

// Each Markdown file is one passage. Standalone --- lines divide its fragments.
const fragmentQueues = passages.map((passage) => ({
  author: passage.data.author,
  fragments: (passage.body ?? "")
    .split(/^\s*(?:\*\*---\*\*|---)\s*$/gm)
    .map((text) =>
      text
        .trim()
        .replace(/&(?:#x20|nbsp);/gi, " ")
        .trim(),
    )
    .filter(Boolean),
}));

// Interweave authors without ever changing the order within a passage.
const orderedFragments: { type: "fragment"; author: string; text: string }[] =
  [];
while (fragmentQueues.some((queue) => queue.fragments.length > 0)) {
  const available = fragmentQueues.filter(
    (queue) => queue.fragments.length > 0,
  );
  const chosen = available[Math.floor(Math.random() * available.length)];
  orderedFragments.push({
    type: "fragment",
    author: chosen.author,
    text: chosen.fragments.shift()!,
  });
}

// Spread text across photo slots, retaining the order of all fragments.
// A slot is after a photograph; multiple fragments may share a slot when
// there are more fragments than photographs.
const slots: (typeof orderedFragments)[] = Array.from(
  { length: sightings.length + 1 },
  () => [],
);
orderedFragments.forEach((fragment, index) => {
  const idealSlot = Math.round(
    ((index + 1) * (sightings.length + 1)) / (orderedFragments.length + 1),
  );
  slots[Math.min(sightings.length, idealSlot)].push(fragment);
});

const observations = [
  ...slots[0],
  ...sightings.flatMap((sighting, index) => [
    { type: "sighting" as const, sighting },
    ...slots[index + 1],
  ]),
];
---

<BaseLayout title="blue hour observatory" ogImage="/og-observatory.jpeg">
  <button
    id="audio-toggle"
    type="button"
    class="machine-link audio-btn"
    slot="header-left"
    aria-label="Turn audio on"
    aria-pressed="false">[ AUDIO: OFF ]</button
  >

  <audio id="bg-player" preload="metadata"></audio>

  <main class="page">
    <header class="intro">
      <h1 aria-label="blue hour observatory">
        <span aria-hidden="true">observatory</span>
      </h1>
    </header>

    <section class="gallery" aria-label="Blue hour sightings">
      {
        observations.map((observation, index) => {
          if (observation.type === "fragment") {
            const isLast = !observations
              .slice(index + 1)
              .some(
                (item) =>
                  item.type === "fragment" &&
                  item.author === observation.author,
              );

            return (
              <blockquote class="fragment-item">
                <p class="fragment-text">{observation.text}</p>
                {isLast && (
                  <div class="fragment-author">{observation.author}</div>
                )}
              </blockquote>
            );
          }

          const { sighting } = observation;
          const photoIndex = observations
            .slice(0, index)
            .filter((item) => item.type === "sighting").length;
          const metaString = [
            sighting.data.date,
            sighting.data.time,
            sighting.data.location,
            sighting.data.author ? `by ${sighting.data.author}` : null,
          ]
            .filter(Boolean)
            .join(" · ");

          return (
            <figure class={`gallery-item photo-layout-${photoIndex % 5}`}>
              <img
                src={sighting.data.image}
                alt={
                  sighting.data.location
                    ? `Blue hour sighting in ${sighting.data.location}`
                    : "Blue hour sighting"
                }
                loading={photoIndex < 2 ? "eager" : "lazy"}
                decoding="async"
              />
              {metaString && (
                <figcaption class="gallery-meta">{metaString}</figcaption>
              )}
            </figure>
          );
        })
      }
    </section>

    <footer class="outro">
      <p>
        Have you seen it too? <a
          href="#tally-open=jaRg2R&tally-overlay=1&tally-auto-close=3000"
          >Report a sighting.</a
        >
      </p>
    </footer>
  </main>

  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="filter-defs"
    aria-hidden="true"
  >
    <filter id="universalGrain" x="0" y="0" width="100%" height="100%">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="3"
        numOctaves="4"
        stitchTiles="stitch"
        result="rawNoise"></feTurbulence>
      <feColorMatrix
        type="matrix"
        values="0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0 0 0 1 0"
        in="rawNoise"
        result="monoNoise"></feColorMatrix>
      <feGaussianBlur stdDeviation="0.35" in="monoNoise" result="blurredNoise"
      ></feGaussianBlur>
      <feComponentTransfer in="blurredNoise" result="softNoise"
        ><feFuncA type="linear" slope="0.60"></feFuncA></feComponentTransfer
      >
      <feBlend mode="overlay" in="SourceGraphic" in2="softNoise"></feBlend>
    </filter>
  </svg>

  <style>
    .page {
      box-sizing: border-box;
      width: min(100% - 2rem, 78rem);
      margin-inline: auto;
      padding: 0 0 8rem;
    }

    .intro {
      min-height: 82svh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 1.4rem;
    }

    .intro h1 {
      margin: 0;
    }
    .intro p {
      margin: 0;
    }
    .intro a,
    .outro a {
      color: inherit;
      text-underline-offset: 0.2em;
    }

    .gallery {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: clamp(6rem, 13vw, 13rem);
      width: 100%;
    }

    .gallery-item {
      box-sizing: border-box;
      width: 48%;
      margin: 0;
      min-width: 0;
      border: none;
      box-shadow: none;
      background: transparent;
      padding: 0;
    }

    .gallery-item.photo-layout-0 {
      width: 68%;
      align-self: center;
    }
    .gallery-item.photo-layout-1 {
      width: 34%;
      align-self: flex-end;
    }
    .gallery-item.photo-layout-2 {
      width: 52%;
      align-self: flex-start;
    }
    .gallery-item.photo-layout-3 {
      width: 28%;
      margin-left: 18%;
    }
    .gallery-item.photo-layout-4 {
      width: 75%;
      align-self: flex-end;
    }

    .fragment-item {
      box-sizing: border-box;
      width: min(100%, 36rem);
      margin: 0;
      padding: clamp(2rem, 5vw, 4rem) 0;
      align-self: center;
      border: 0;
      background: transparent;
    }

    .fragment-text {
      margin: 0;
      font-size: clamp(1rem, 1.5vw, 1.2rem);
      line-height: 1.85;
      color: var(--muted);
      white-space: pre-line;
      font-family: var(--font-syne-mono);
      font-style: italic;
    }

    .fragment-author {
      margin-top: 1.75rem;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 0.8rem;
      line-height: 1.5;
      color: var(--muted);
      opacity: 0.7;
      text-transform: lowercase;
    }

    .gallery-item img {
      display: block;
      width: 100%;
      height: auto;
      filter: url(#universalGrain) brightness(0.85) contrast(1.15) saturate(0.8);
      opacity: 0.88;
      transition:
        opacity 400ms ease,
        filter 400ms ease;
    }
    @media (hover: hover) and (pointer: fine) {
      .gallery-item:hover img {
        opacity: 1;
        filter: url(#universalGrain) brightness(1) contrast(1.08) saturate(0.95);
      }

      .gallery-item:hover .gallery-meta {
        opacity: 1;
      }
    }

    @media (hover: none) {
      .gallery-item.is-active img {
        opacity: 1;
        filter: url(#universalGrain) brightness(1) contrast(1.08) saturate(0.95);
      }

      .gallery-item.is-active .gallery-meta {
        opacity: 1;
      }
    }

    .gallery-meta {
      margin-top: 0.75rem;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 0.8rem;
      line-height: 1.5;
      letter-spacing: 0.01em;
      color: var(--muted);
      opacity: 0.5;
      transition: opacity 200ms ease;
      overflow-wrap: anywhere;
    }

    .outro {
      min-height: 55svh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      text-align: center;
      font-family: var(--font-syne-mono);
      color: var(--light);
    }
    .outro p {
      margin: 0;
    }
    .outro p a:hover {
      color: var(--glow);
    }
    .audio-btn {
      color: var(--light);
      border: 0;
      background: transparent;
      height: auto;
      padding: 0;
      line-height: 1;
      cursor: pointer;
    }
    .filter-defs {
      position: absolute;
      width: 0;
      height: 0;
      overflow: hidden;
    }

    @media (max-width: 600px) {
      .page {
        width: calc(100% - 2rem);
      }
      .intro {
        min-height: 56svh;
      }
      .intro .copy {
        font-size: 0.9rem;
        line-height: 1.5;
      }
      .outro p {
        max-width: 19rem;
        margin-inline: auto;
      }
      .outro p a {
        display: block;
        width: fit-content;
        margin: 0.25rem auto 0;
      }
      .audio-btn {
        white-space: nowrap;
      }
      .gallery {
        gap: 6rem;
      }
      .gallery-item,
      .gallery-item:nth-child(n) {
        width: 85%;
        margin-left: 0;
        align-self: flex-start;
      }
      .gallery-item:nth-child(even) {
        align-self: flex-end;
      }
      .fragment-item {
        width: 88%;
        padding-block: 2rem;
      }
      .fragment-text {
        font-size: 1rem;
      }
      .gallery-meta {
        opacity: 0.8;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .gallery-item img,
      .gallery-meta {
        transition: none;
      }
    }
  </style>
</BaseLayout>

<script define:vars={{ playlist }}>
  function shuffle(array) {
    const shuffled = [...array];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
  }

  const shuffledPlaylist = shuffle(playlist || []);
  let currentIndex = 0;
  let isPlaying = false;
  const audioBtn = document.getElementById("audio-toggle");
  const player = document.getElementById("bg-player");

  function loadAndPlay(index) {
    if (!player || shuffledPlaylist.length === 0) return;
    currentIndex = index % shuffledPlaylist.length;
    player.src = shuffledPlaylist[currentIndex].src;
    if (isPlaying) player.play().catch(() => setAudioState(false));
  }

  function setAudioState(active) {
    isPlaying = active;
    if (!audioBtn || !player) return;
    audioBtn.textContent = isPlaying ? "[ AUDIO: ON ]" : "[ AUDIO: OFF ]";
    audioBtn.setAttribute(
      "aria-label",
      isPlaying ? "Turn audio off" : "Turn audio on",
    );
    audioBtn.setAttribute("aria-pressed", String(isPlaying));
    audioBtn.classList.toggle("active", isPlaying);
    if (isPlaying) {
      if (!player.src) loadAndPlay(0);
      else player.play().catch(() => setAudioState(false));
    } else player.pause();
  }

  audioBtn?.addEventListener("click", () => setAudioState(!isPlaying));
  player?.addEventListener("ended", () => loadAndPlay(currentIndex + 1));
  player?.addEventListener("error", () => {
    if (shuffledPlaylist.length > 1) loadAndPlay(currentIndex + 1);
    else setAudioState(false);
  });
  document.querySelectorAll(".gallery-item img").forEach((img) => {
    img.addEventListener("click", () => {
      if (window.matchMedia("(hover: none)").matches) {
        img.closest(".gallery-item")?.classList.toggle("is-active");
      }
    });
  });
</script>
