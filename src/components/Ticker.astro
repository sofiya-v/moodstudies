---
import { Font } from "astro:assets";

interface Props {
  items: string[];
  duration?: number;
}

const { items, duration = 75 } = Astro.props;
const text = items.join("... ");
---

<div class="film-ticker-container">
  <div class="ticker" aria-label={text}>
    <div class="ticker-track" style={`--ticker-duration: ${duration}s`}>
      <span>{text}...</span>
      <span aria-hidden="true">{text}... </span>
    </div>
  </div>

  <style>
    .film-ticker-container {
      position: relative;
      width: 100%;
      overflow: hidden;
      padding-block: 0.5rem;

      /* Dissolves light intensity at the edges without adding dark boxes */
      mask-image: linear-gradient(
        to right,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 1) 12%,
        rgba(0, 0, 0, 1) 88%,
        rgba(0, 0, 0, 0) 100%
      );
      -webkit-mask-image: linear-gradient(
        to right,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 1) 12%,
        rgba(0, 0, 0, 1) 88%,
        rgba(0, 0, 0, 0) 100%
      );
    }

    /* Subtle scanlines that interact directly with the film grain underneath */
    .film-ticker-container::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 3;
      background: repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.35),
        rgba(0, 0, 0, 0.35) 1px,
        transparent 1px,
        transparent 3px
      );
      mix-blend-mode: overlay;
      opacity: 0.4;
    }

    .ticker {
      width: 100%;
      padding-left: 10rem;
      color: #6bfbe2;
      padding-block: 0.75rem;
      font-family: var(--machine-text), monospace;
      font-size: 1.2rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      -webkit-font-smoothing: none !important;
      -moz-osx-font-smoothing: unset !important;
      font-smooth: never !important;
      text-rendering: optimizeSpeed !important;

      color: var(--glow);
      text-transform: uppercase;

      /* Composites the text and glow directly into your film background */
      text-shadow:
        0 0 2px #fff,
        0 0 8px rgba(0, 255, 200, 0.95),
        0 0 22px rgba(0, 255, 200, 0.5);
    }

    .ticker-track {
      display: flex;
      width: max-content;
      will-change: transform;
      transform: translate3d(0, 0, 0);
      animation: ticker var(--ticker-duration) linear infinite;
    }

    @keyframes ticker {
      to {
        transform: translate3d(-50%, 0, 0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .ticker-track {
        animation: none;
      }

      .ticker {
        overflow-x: auto;
      }
    }
  </style>
</div>
