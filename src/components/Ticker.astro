---
import { Font } from "astro:assets";

interface Props {
  items: string[];
  duration?: number;
}

const { items, duration = 75 } = Astro.props;
const text = items.join("... ");
---

<head>
  <Font cssVariable="--font-silkscreen" preload />
</head>
<div class="ticker" aria-label={text}>
  <div class="ticker-track" style={`--ticker-duration: ${duration}s`}>
    <span>{text}...</span>
    <span aria-hidden="true">{text}... </span>
  </div>
</div>

<style>
  .ticker {
    width: 100%;
    color: white;
    overflow: hidden;
    padding-block: 0.6rem;
    text-shadow:
      0 0 4px rgba(255, 255, 255, 1),
      0 0 7px rgba(0, 255, 200, 0.8),
      /* Intense inner color */ 0 0 30px rgba(0, 255, 200, 0.6),
      /* Mid-range spread */ 3px 5px 5px rgba(0, 0, 0, 0.7);
    font-family: var(--font-silkscreen);
    font-size: 1.5rem;
  }

  @media (max-width: 480px) {
    .ticker {
      font-size: 0.75rem;
      text-shadow: 0.5px 0.5px 0.5px white;
    }
  }
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker var(--ticker-duration) linear infinite;
  }

  .ticker-track span {
    white-space: nowrap;
    padding-right: 0.35rem;
  }

  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }

    .ticker {
      overflow-x: auto;
    }
  }
</style>
