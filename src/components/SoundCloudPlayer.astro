---
interface Props {
  trackId: string;
}

const { trackId } = Astro.props;

const playerUrl =
  `https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/soundcloud%253Atracks%253A${trackId}` +
  `&color=%235c1309` +
  `&inverse=true` +
  `&auto_play=false` +
  `&style="color: b3ffbd"` +
  `&show_user=false`;
---

<iframe
  class="soundcloud-player"
  width="100%"
  height="20"
  allow="autoplay; encrypted-media"
  src={playerUrl}
  title="SoundCloud player"
>
</iframe>

<style>
  .soundcloud-player {
    display: block;
    width: 50%;
    justify-self: center;
    font-family: var(--font-syne-mono);
    border: 0;
    color: var(--bg);
    margin: 5rem;
  }

  @media (max-width: 768px) {
    .soundcloud-player {
      width: 100%;
      margin: 2rem 0;
    }
  }
</style>
