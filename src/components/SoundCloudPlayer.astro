---
interface Props {
  trackId: string;
}

const { trackId } = Astro.props;

const playerUrl =
  `https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/soundcloud%253Atracks%253A${trackId}` +
  `&color=%236e4d8c` +
  `&inverse=true` +
  `&auto_play=false` +
  `&show_user=false`;
---

<iframe
  class="soundcloud-player"
  width="100%"
  height="20"
  allow="autoplay; encrypted-media"
  src={playerUrl}
  title="SoundCloud player"
>
</iframe>

<style>
  .soundcloud-player {
    display: block;
    width: 100%;
    border: 0;
  }
</style>
