---
interface Props {
  trackId: string;
}

const { trackId } = Astro.props;
const targetUrl = encodeURIComponent(
  `https://api.soundcloud.com/tracks/${trackId}`,
);
const iframeSrc = `https://w.soundcloud.com/player/?url=${targetUrl}&enable_api=true`;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=VT323&display=swap"
  rel="stylesheet"
/>

<script is:inline src="https://w.soundcloud.com/player/api.js"></script>
<iframe id="sc-hidden-iframe" src={iframeSrc} allow="autoplay"></iframe>

<div class="audio-deck">
  <!-- LEFT: RADIAL SCOPE & TRANSPORT CONTROLS -->
  <div class="deck-group left-controls">
    <div class="radial-stage">
      <canvas id="canvas-radial"></canvas>
    </div>

    <button id="sk-play-btn" class="control-btn" aria-label="Play / Pause">
      <svg id="icon-play" viewBox="0 0 24 24" class="btn-icon">
        <path d="M8 5v14l11-7z" fill="currentColor"></path>
      </svg>
      <svg id="icon-pause" viewBox="0 0 24 24" class="btn-icon hidden">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" fill="currentColor"></path>
      </svg>
    </button>
  </div>

  <!-- CENTER-LEFT: TRACK INFORMATION -->
  <div class="deck-group track-info">
    <span class="track-title" id="sc-title">TRANSMISSION</span>
    <a
      class="machine-link sc-link"
      id="sc-external-link"
      href="#"
      target="_blank"
      rel="noopener">Soundcloud</a
    >
  </div>

  <!-- CENTER-RIGHT: CONSTRAINED SCRUBBER -->
  <div class="scrubber-stage">
    <canvas id="canvas-scrubber"></canvas>
  </div>

  <!-- RIGHT: TIMECODE -->
  <div class="deck-group right-controls">
    <span id="time-current" class="time-code">00:00:00</span>
  </div>
</div>

<script>
  declare global {
    interface Window {
      SC: any;
    }
  }

  const setupAudioDeck = () => {
    const iframe = document.getElementById(
      "sc-hidden-iframe",
    ) as HTMLIFrameElement;
    if (!iframe || typeof window.SC === "undefined") return;

    const widget = window.SC.Widget(iframe);
    const titleText = document.getElementById("sc-title");
    const scExternalLink = document.getElementById(
      "sc-external-link",
    ) as HTMLAnchorElement;
    const playBtn = document.getElementById("sk-play-btn");
    const iconPlay = document.getElementById("icon-play");
    const iconPause = document.getElementById("icon-pause");
    const timeCurrent = document.getElementById("time-current");

    const scrubCanvas = document.getElementById(
      "canvas-scrubber",
    ) as HTMLCanvasElement;
    const ctxScrub = scrubCanvas?.getContext("2d");

    const radialCanvas = document.getElementById(
      "canvas-radial",
    ) as HTMLCanvasElement;
    const ctxRadial = radialCanvas?.getContext("2d");

    let isPlaying = false;
    let masterProgressRatio = 0;
    let trackDuration = 0;
    let currentPosMs = 0;
    let phase = 0;
    let isScrubbing = false;
    let waveformPeaks: number[] = [];
    let maxTrackPeak = 1;
    let currentPulse = 0;

    const resizeCanvases = () => {
      if (scrubCanvas && scrubCanvas.parentElement) {
        scrubCanvas.width = scrubCanvas.parentElement.clientWidth;
        scrubCanvas.height = scrubCanvas.parentElement.clientHeight;
      }
      if (radialCanvas && radialCanvas.parentElement) {
        radialCanvas.width = radialCanvas.parentElement.clientWidth;
        radialCanvas.height = radialCanvas.parentElement.clientHeight;
      }
    };
    resizeCanvases();
    window.addEventListener("resize", resizeCanvases);

    const PHOSPHOR_COLOR = "#ff4500";
    const PHOSPHOR_DIM = "rgba(255, 69, 0, 0.4)";

    const formatTime = (ms: number) => {
      if (!ms || isNaN(ms)) return "00:00:00";
      const totalSec = Math.floor(ms / 1000);
      const h = Math.floor(totalSec / 3600);
      const m = Math.floor((totalSec % 3600) / 60);
      const s = totalSec % 60;
      return `${h.toString().padStart(2, "0")}:${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
    };

    // STRAIGHT-LINE SCRUBBER
    const renderScrubber = () => {
      if (!ctxScrub || !scrubCanvas) return;
      const w = scrubCanvas.width;
      const h = scrubCanvas.height;
      ctxScrub.clearRect(0, 0, w, h);

      const paddingX = 4;
      const usableWidth = w - paddingX * 2;
      const cy = Math.floor(h / 2);
      const scrubX = paddingX + masterProgressRatio * usableWidth;

      // Frame Brackets
      ctxScrub.strokeStyle = PHOSPHOR_DIM;
      ctxScrub.lineWidth = 1.2;
      ctxScrub.beginPath();
      ctxScrub.moveTo(paddingX, 2);
      ctxScrub.lineTo(paddingX, h - 2);
      ctxScrub.moveTo(w - paddingX, 2);
      ctxScrub.lineTo(w - paddingX, h - 2);
      ctxScrub.stroke();

      // Base Line (Unplayed)
      ctxScrub.strokeStyle = "rgba(255, 69, 0, 0.25)";
      ctxScrub.lineWidth = 1.5;
      ctxScrub.beginPath();
      ctxScrub.moveTo(paddingX, cy);
      ctxScrub.lineTo(w - paddingX, cy);
      ctxScrub.stroke();

      // Played Line
      if (scrubX > paddingX) {
        ctxScrub.save();
        ctxScrub.strokeStyle = PHOSPHOR_COLOR;
        ctxScrub.lineWidth = 3;
        ctxScrub.shadowColor = "#ff3300";
        ctxScrub.shadowBlur = 16;
        ctxScrub.beginPath();
        ctxScrub.moveTo(paddingX, cy);
        ctxScrub.lineTo(scrubX, cy);
        ctxScrub.stroke();
        ctxScrub.restore();
      }

      // Playhead Indicator
      ctxScrub.save();
      ctxScrub.strokeStyle = "#ffe5b4";
      ctxScrub.lineWidth = 1.5;
      ctxScrub.shadowColor = "#ff4500";
      ctxScrub.shadowBlur = 22;

      ctxScrub.beginPath();
      ctxScrub.moveTo(scrubX, 1);
      ctxScrub.lineTo(scrubX, h - 1);
      ctxScrub.stroke();

      ctxScrub.fillStyle = "#ffe5b4";
      ctxScrub.beginPath();
      ctxScrub.moveTo(scrubX - 3.5, cy);
      ctxScrub.lineTo(scrubX, cy - 3.5);
      ctxScrub.lineTo(scrubX + 3.5, cy);
      ctxScrub.lineTo(scrubX, cy + 3.5);
      ctxScrub.closePath();
      ctxScrub.fill();

      ctxScrub.restore();
    };

    let scopeMorph = 0;
    let continuousPhase = 0;

    // LISSAJOUS
    const renderScope = () => {
      if (!ctxRadial || !radialCanvas) return;
      const w = radialCanvas.width;
      const h = radialCanvas.height;
      const cx = w / 2;
      const cy = h / 2;
      const maxRadius = Math.min(w, h) * 0.42;

      ctxRadial.clearRect(0, 0, w, h);

      const AMBER_RED_MAIN = "#ff4500";
      const AMBER_RED_GRID = "rgba(255, 69, 0, 0.15)";

      const targetMorph = isPlaying ? 1 : 0;
      scopeMorph += (targetMorph - scopeMorph) * 0.05;

      const currentSpeed = 0.003 + scopeMorph * 0.022;
      continuousPhase += currentSpeed;

      const idlePulse = (Math.sin(continuousPhase * 5) + 1) / 2;

      const centerIdx = Math.floor(masterProgressRatio * waveformPeaks.length);
      const currentPeak = waveformPeaks[centerIdx] || 0;

      const lookaheadOffset = 4;
      const nextIdx = Math.min(
        waveformPeaks.length - 1,
        centerIdx + lookaheadOffset,
      );
      const futurePeak = waveformPeaks[nextIdx] || 0;
      const prevPeak = waveformPeaks[Math.max(0, centerIdx - 2)] || 0;

      const delta = Math.max(0, currentPeak - prevPeak);
      if (isPlaying && delta > 0.1) {
        currentPulse = Math.min(1.0, currentPulse + delta * 1.8);
      }
      currentPulse *= 0.9;

      const normCurrent = (currentPeak / (maxTrackPeak || 1)) * scopeMorph;
      const normFuture = (futurePeak / (maxTrackPeak || 1)) * scopeMorph;
      const ampA = Math.pow(normCurrent, 0.85);
      const ampB = Math.pow(normFuture, 0.85);

      ctxRadial.save();

      ctxRadial.strokeStyle = AMBER_RED_GRID;
      ctxRadial.lineWidth = 1;

      ctxRadial.beginPath();
      ctxRadial.arc(cx, cy, maxRadius * 0.35, 0, Math.PI * 2);
      ctxRadial.arc(cx, cy, maxRadius * 0.7, 0, Math.PI * 2);
      ctxRadial.arc(cx, cy, maxRadius, 0, Math.PI * 2);
      ctxRadial.stroke();

      ctxRadial.beginPath();
      ctxRadial.moveTo(cx - maxRadius - 2, cy);
      ctxRadial.lineTo(cx + maxRadius + 2, cy);
      ctxRadial.moveTo(cx, cy - maxRadius - 2);
      ctxRadial.lineTo(cx, cy + maxRadius + 2);
      ctxRadial.stroke();

      const numPoints = 120;

      const freqX = 1 + (3 - 1) * scopeMorph;
      const freqY = 1 + (2 - 1) * scopeMorph;

      const lineAlpha =
        0.5 + idlePulse * 0.4 * (1 - scopeMorph) + scopeMorph * 0.95;
      const glowBlur =
        (6 + idlePulse * 10) * (1 - scopeMorph) +
        (10 + currentPulse * 18) * scopeMorph;

      ctxRadial.strokeStyle = `rgba(255, 69, 0, ${lineAlpha})`;
      ctxRadial.lineWidth = 1.4;
      ctxRadial.shadowColor = "#ff3300";
      ctxRadial.shadowBlur = glowBlur;

      const beamJitterX = (Math.random() - 0.5) * currentPulse * 3 * scopeMorph;
      const beamJitterY = (Math.random() - 0.5) * currentPulse * 3 * scopeMorph;

      const baseScale = 0.65 * (1 - scopeMorph) + 0.38 * scopeMorph;
      const pulseExpansion =
        1 +
        currentPulse * 0.15 * scopeMorph +
        idlePulse * 0.04 * (1 - scopeMorph);

      ctxRadial.beginPath();
      for (let i = 0; i <= numPoints; i++) {
        const theta = (i / numPoints) * Math.PI * 2;

        const modX =
          Math.sin(theta * freqX + continuousPhase * 1.4) *
          (ampA * maxRadius * 0.42);
        const modY =
          Math.cos(theta * freqY - continuousPhase * 0.9) *
          (ampB * maxRadius * 0.42);

        const baseRadius = maxRadius * baseScale * pulseExpansion;
        const rx = baseRadius + modX;
        const ry = baseRadius + modY;

        const x = cx + Math.cos(theta) * rx + beamJitterX;
        const y = cy + Math.sin(theta) * ry + beamJitterY;

        if (i === 0) ctxRadial.moveTo(x, y);
        else ctxRadial.lineTo(x, y);
      }
      ctxRadial.closePath();
      ctxRadial.stroke();

      const spotAlpha =
        (0.7 + idlePulse * 0.3) * (1 - scopeMorph) + 1.0 * scopeMorph;
      const spotRadius =
        (1.8 + idlePulse * 0.8) * (1 - scopeMorph) +
        (2.5 + currentPulse * 2.2) * scopeMorph;

      ctxRadial.fillStyle = `rgba(255, 140, 60, ${spotAlpha})`;
      ctxRadial.shadowColor = "#ff3300";
      ctxRadial.shadowBlur =
        (8 + idlePulse * 10) * (1 - scopeMorph) + 18 * scopeMorph;

      ctxRadial.beginPath();
      ctxRadial.arc(cx, cy, spotRadius, 0, Math.PI * 2);
      ctxRadial.fill();

      ctxRadial.restore();
    };

    const loop = () => {
      phase += isPlaying ? 0.025 : 0.004;
      renderScrubber();
      renderScope();
      requestAnimationFrame(loop);
    };

    loop();

    widget.bind(window.SC.Widget.Events.READY, () => {
      widget.getDuration((d: number) => {
        trackDuration = d;
      });
      widget.getCurrentSound((sound: any) => {
        if (sound) {
          if (titleText) {
            titleText.textContent = sound.title.toUpperCase();
          }
          if (scExternalLink) {
            scExternalLink.href = sound.permalink_url;
          }
          if (sound.waveform_url) {
            fetch(sound.waveform_url.replace(".png", ".json"))
              .then((res) => res.json())
              .then((data) => {
                if (data?.samples?.length) {
                  const max = Math.max(...data.samples, 1);
                  waveformPeaks = data.samples.map((s: number) => s / max);
                  maxTrackPeak = 1;
                }
              })
              .catch((err) =>
                console.error("Failed loading SoundCloud waveform:", err),
              );
          }
        }
      });
    });

    playBtn?.addEventListener("click", () => widget.toggle());

    widget.bind(window.SC.Widget.Events.PLAY, () => {
      isPlaying = true;
      iconPlay?.classList.add("hidden");
      iconPause?.classList.remove("hidden");
    });

    widget.bind(window.SC.Widget.Events.PAUSE, () => {
      isPlaying = false;
      iconPause?.classList.add("hidden");
      iconPlay?.classList.remove("hidden");
    });

    widget.bind(window.SC.Widget.Events.PLAY_PROGRESS, (data: any) => {
      if (!isScrubbing) {
        masterProgressRatio = data.relativePosition;
        currentPosMs = data.currentPosition;
        if (timeCurrent) timeCurrent.textContent = formatTime(currentPosMs);
      }
    });

    const handleScrub = (e: MouseEvent) => {
      if (!scrubCanvas) return;
      const paddingX = 4;
      const rect = scrubCanvas.getBoundingClientRect();
      const usableWidth = rect.width - paddingX * 2;
      const clickX = e.clientX - rect.left - paddingX;

      masterProgressRatio = Math.max(0, Math.min(1, clickX / usableWidth));
      if (trackDuration) {
        currentPosMs = Math.floor(trackDuration * masterProgressRatio);
        if (timeCurrent) timeCurrent.textContent = formatTime(currentPosMs);
        widget.seekTo(currentPosMs);
      }
    };

    window.addEventListener("keydown", function (event) {
      if (event.code === "Space") {
        event.preventDefault();
        widget.toggle();
      }
    });

    scrubCanvas?.addEventListener("mousedown", (e) => {
      isScrubbing = true;
      handleScrub(e);
    });

    window.addEventListener("mousemove", (e) => {
      if (isScrubbing) handleScrub(e);
    });

    window.addEventListener("mouseup", () => {
      isScrubbing = false;
    });
  };

  if (document.readyState === "complete") setupAudioDeck();
  else window.addEventListener("load", setupAudioDeck);
</script>

<style>
  #sc-hidden-iframe {
    position: fixed !important;
    top: -9999px !important;
    left: -9999px !important;
    width: 0 !important;
    height: 0 !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .audio-deck {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    padding: 2rem 1.5rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.5rem;
    background: transparent;
    backdrop-filter: none;
    border-bottom: none;
    font-family: "VT323", var(--machine-text, monospace);
    color: #ffdab9;
    overflow: visible;
    /* Expanded padding & overflow: visible so the intense darkroom bulb bloom haze never gets clipped by container boundaries */
    filter: drop-shadow(0 0 32px rgba(255, 69, 0, 0.85))
      drop-shadow(0 0 14px rgba(255, 30, 0, 0.8));
  }

  .deck-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .left-controls {
    gap: 0.75rem;
  }

  .track-info {
    gap: 1.5rem;
    min-width: 0;
  }

  .right-controls {
    gap: 0.75rem;
  }

  /* SCRUBBER STAGE: Constrained width to prevent over-stretching */
  .scrubber-stage {
    flex: 0 1 300px;
    width: 100%;
    max-width: 300px;
    height: 22px;
    margin-top: 2px;
    min-width: 80px;
    overflow: visible;
  }

  .radial-stage {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    overflow: visible;
  }

  .control-btn {
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    transition:
      transform 0.1s ease,
      opacity 0.2s ease;
  }

  .control-btn:hover {
    opacity: 0.85;
  }

  .control-btn:active {
    transform: scale(0.92);
  }

  .btn-icon {
    width: 22px;
    height: 22px;
    filter: drop-shadow(0 0 10px rgba(255, 69, 0, 0.95))
      drop-shadow(0 0 4px rgba(255, 200, 150, 0.7));
  }

  .hidden {
    display: none !important;
  }

  .track-title {
    color: #fff5ee;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 1.1rem;
    letter-spacing: 0.5px;
    max-width: 240px;
    text-shadow:
      0 0 14px rgba(255, 69, 0, 0.95),
      0 0 6px rgba(255, 180, 120, 0.7);
  }

  .sc-link {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    font-size: 1.05rem;
    flex-shrink: 0;
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .sc-link:hover {
    opacity: 1;
    text-shadow: 0 0 10px rgba(255, 69, 0, 0.9);
  }

  #canvas-radial,
  #canvas-scrubber {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  #canvas-scrubber {
    cursor: crosshair;
  }

  .time-code {
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.95;
    white-space: nowrap;
    flex-shrink: 0;
    text-shadow: 0 0 10px rgba(255, 69, 0, 0.85);
  }

  @media (max-width: 768px) {
    .audio-deck {
      gap: 0.75rem;
      padding: 1.5rem 0.75rem;
    }

    .track-title {
      max-width: 120px;
    }

    .scrubber-stage {
      max-width: 140px;
    }

    .track-info {
      gap: 0.75rem;
    }
  }
</style>
