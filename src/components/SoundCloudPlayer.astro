---
interface Props {
  trackId: string;
}

const { trackId } = Astro.props;
const targetUrl = encodeURIComponent(
  `https://api.soundcloud.com/tracks/${trackId}`,
);
const iframeSrc = `https://w.soundcloud.com/player/?url=${targetUrl}&enable_api=true`;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=VT323&display=swap"
  rel="stylesheet"
/>

<script is:inline src="https://w.soundcloud.com/player/api.js"></script>
<iframe id="sc-hidden-iframe" src={iframeSrc} allow="autoplay"></iframe>

<div class="audio-deck">
  <!-- DYNAMIC RADIAL SCOPE (RESPONDS TO LIVE AMPLITUDE) -->
  <div class="radial-stage">
    <canvas id="canvas-radial"></canvas>
  </div>

  <!-- STATIC TRACK SCRUBBER MAP -->
  <div class="scrubber-stage">
    <canvas id="canvas-scrubber"></canvas>
  </div>

  <!-- READOUT & CONTROLS -->
  <div class="signal-readout">
    <span id="sk-play" class="signal-trigger">&gt; PLAY &lt;</span>
    <a id="sc-title-link" href="#" target="_blank" rel="noopener"
      >TRANSMISSION</a
    >
    <span id="time-current" class="time-code">00:00:00</span>
  </div>
</div>

<script>
  declare global {
    interface Window {
      SC: any;
    }
  }

  const setupAudioDeck = () => {
    const iframe = document.getElementById(
      "sc-hidden-iframe",
    ) as HTMLIFrameElement;
    if (!iframe || typeof window.SC === "undefined") return;

    const widget = window.SC.Widget(iframe);
    const titleLink = document.getElementById(
      "sc-title-link",
    ) as HTMLAnchorElement;
    const playBtn = document.getElementById("sk-play");
    const timeCurrent = document.getElementById("time-current");

    const scrubCanvas = document.getElementById(
      "canvas-scrubber",
    ) as HTMLCanvasElement;
    const ctxScrub = scrubCanvas?.getContext("2d");

    const radialCanvas = document.getElementById(
      "canvas-radial",
    ) as HTMLCanvasElement;
    const ctxRadial = radialCanvas?.getContext("2d");

    let isPlaying = false;
    let masterProgressRatio = 0;
    let trackDuration = 0;
    let currentPosMs = 0;
    let phase = 0;
    let isScrubbing = false;
    let waveformPeaks: number[] = [];
    let maxTrackPeak = 1;
    let currentPulse = 0;

    const resizeCanvases = () => {
      if (scrubCanvas && scrubCanvas.parentElement) {
        scrubCanvas.width = scrubCanvas.parentElement.clientWidth;
        scrubCanvas.height = scrubCanvas.parentElement.clientHeight;
      }
      if (radialCanvas && radialCanvas.parentElement) {
        radialCanvas.width = radialCanvas.parentElement.clientWidth;
        radialCanvas.height = radialCanvas.parentElement.clientHeight;
      }
    };
    resizeCanvases();
    window.addEventListener("resize", resizeCanvases);

    const PHOSPHOR_COLOR = "#33ffcc";
    const PHOSPHOR_DIM = "rgba(51, 255, 204, 0.25)";

    const formatTime = (ms: number) => {
      if (!ms || isNaN(ms)) return "00:00:00";
      const totalSec = Math.floor(ms / 1000);
      const h = Math.floor(totalSec / 3600);
      const m = Math.floor((totalSec % 3600) / 60);
      const s = totalSec % 60;
      return `${h.toString().padStart(2, "0")}:${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
    };

    // STATIC WAVEFORM SCRUBBER
    const renderScrubber = () => {
      if (!ctxScrub || !scrubCanvas) return;
      const w = scrubCanvas.width;
      const h = scrubCanvas.height;
      ctxScrub.clearRect(0, 0, w, h);

      const paddingY = 8;
      const paddingX = 6;
      const usableWidth = w - paddingX * 2;
      const cy = h - paddingY;
      const maxAmp = h - paddingY * 2;
      const scrubX = paddingX + masterProgressRatio * usableWidth;

      // Bookends & Frame
      ctxScrub.strokeStyle = PHOSPHOR_DIM;
      ctxScrub.lineWidth = 1;
      ctxScrub.beginPath();
      ctxScrub.moveTo(paddingX, 0);
      ctxScrub.lineTo(paddingX, h);
      ctxScrub.moveTo(paddingX, cy);
      ctxScrub.lineTo(paddingX + 4, cy);
      ctxScrub.moveTo(w - paddingX, 0);
      ctxScrub.lineTo(w - paddingX, h);
      ctxScrub.moveTo(w - paddingX, cy);
      ctxScrub.lineTo(w - paddingX - 4, cy);
      ctxScrub.stroke();

      // Zero-line baseline
      ctxScrub.strokeStyle = "rgba(51, 255, 204, 0.12)";
      ctxScrub.beginPath();
      ctxScrub.moveTo(paddingX, cy);
      ctxScrub.lineTo(w - paddingX, cy);
      ctxScrub.stroke();

      if (!waveformPeaks.length) return;

      const step = 2;
      const getScaledY = (sampleIndex: number) => {
        const rawPeak = waveformPeaks[sampleIndex] || 0;
        const normalized = rawPeak / (maxTrackPeak || 1);
        return cy - Math.pow(normalized, 0.85) * maxAmp;
      };

      const buildGraphPath = (startX: number, endX: number) => {
        ctxScrub.beginPath();
        let started = false;
        for (let x = startX; x <= endX; x += step) {
          const ratio = (x - paddingX) / usableWidth;
          const sampleIndex = Math.floor(ratio * waveformPeaks.length);
          const y = getScaledY(sampleIndex);
          if (!started) {
            ctxScrub.moveTo(x, y);
            started = true;
          } else {
            ctxScrub.lineTo(x, y);
          }
        }
      };

      // Ghost Unplayed Trace
      if (scrubX < w - paddingX) {
        ctxScrub.save();
        ctxScrub.strokeStyle = PHOSPHOR_DIM;
        ctxScrub.lineWidth = 1.2;
        buildGraphPath(scrubX, w - paddingX);
        ctxScrub.stroke();
        ctxScrub.restore();
      }

      // Bright Played Trace
      if (scrubX > paddingX) {
        ctxScrub.save();
        ctxScrub.strokeStyle = PHOSPHOR_COLOR;
        ctxScrub.lineWidth = 1.8;
        ctxScrub.shadowColor = PHOSPHOR_COLOR;
        ctxScrub.shadowBlur = 10;
        buildGraphPath(paddingX, scrubX);
        ctxScrub.stroke();
        ctxScrub.restore();
      }

      // Playhead Cursor
      const currentIdx = Math.floor(masterProgressRatio * waveformPeaks.length);
      const cursorY = getScaledY(currentIdx);

      ctxScrub.save();
      ctxScrub.strokeStyle = "rgba(255, 255, 255, 0.35)";
      ctxScrub.lineWidth = 1;
      ctxScrub.beginPath();
      ctxScrub.moveTo(scrubX, 0);
      ctxScrub.lineTo(scrubX, h);
      ctxScrub.stroke();

      ctxScrub.fillStyle = "#ffffff";
      ctxScrub.shadowColor = "#ffffff";
      ctxScrub.shadowBlur = 12;
      ctxScrub.beginPath();
      ctxScrub.arc(scrubX, cursorY, 3.5, 0, Math.PI * 2);
      ctxScrub.fill();
      ctxScrub.restore();
    };

    let scopeMorph = 0;
    let continuousPhase = 0;

    // LISSAJOUS
    const renderScope = () => {
      if (!ctxRadial || !radialCanvas) return;
      const w = radialCanvas.width;
      const h = radialCanvas.height;
      const cx = w / 2;
      const cy = h / 2;
      const maxRadius = Math.min(w, h) * 0.42;

      ctxRadial.clearRect(0, 0, w, h);

      const CYAN_MAIN = "#33ffcc";
      const CYAN_DIM = "rgba(51, 255, 204, 0.25)";
      const CYAN_GRID = "rgba(51, 255, 204, 0.08)";

      // --- Smooth State & Phase Transitions ---
      // Smoothly ease `scopeMorph` toward 1 (playing) or 0 (idle)
      const targetMorph = isPlaying ? 1 : 0;
      scopeMorph += (targetMorph - scopeMorph) * 0.05; // Adjust 0.05 for faster/slower morphing

      // Speed ramps smoothly without phase jumps
      const currentSpeed = 0.003 + scopeMorph * 0.022;
      continuousPhase += currentSpeed;

      // Breathing pulse at rest
      const idlePulse = (Math.sin(continuousPhase * 1.8) + 1) / 2;

      // --- Audio Modulations ---
      const centerIdx = Math.floor(masterProgressRatio * waveformPeaks.length);
      const currentPeak = waveformPeaks[centerIdx] || 0;

      const lookaheadOffset = 4;
      const nextIdx = Math.min(
        waveformPeaks.length - 1,
        centerIdx + lookaheadOffset,
      );
      const futurePeak = waveformPeaks[nextIdx] || 0;
      const prevPeak = waveformPeaks[Math.max(0, centerIdx - 2)] || 0;

      // Transient Detection
      const delta = Math.max(0, currentPeak - prevPeak);
      if (isPlaying && delta > 0.1) {
        currentPulse = Math.min(1.0, currentPulse + delta * 1.8);
      }
      currentPulse *= 0.9;

      // Blend audio amplitude from 0 (resting circle) to live audio peaks
      const normCurrent = (currentPeak / (maxTrackPeak || 1)) * scopeMorph;
      const normFuture = (futurePeak / (maxTrackPeak || 1)) * scopeMorph;
      const ampA = Math.pow(normCurrent, 0.85);
      const ampB = Math.pow(normFuture, 0.85);

      ctxRadial.save();

      // --- 1. CRT Reticle Graticule & Calibration Rings ---
      ctxRadial.strokeStyle = CYAN_GRID;
      ctxRadial.lineWidth = 1;

      ctxRadial.beginPath();
      ctxRadial.arc(cx, cy, maxRadius * 0.35, 0, Math.PI * 2);
      ctxRadial.arc(cx, cy, maxRadius * 0.7, 0, Math.PI * 2);
      ctxRadial.arc(cx, cy, maxRadius, 0, Math.PI * 2);
      ctxRadial.stroke();

      ctxRadial.beginPath();
      ctxRadial.moveTo(cx - maxRadius - 6, cy);
      ctxRadial.lineTo(cx + maxRadius + 6, cy);
      ctxRadial.moveTo(cx, cy - maxRadius - 6);
      ctxRadial.lineTo(cx, cy + maxRadius + 6);
      ctxRadial.stroke();

      ctxRadial.strokeStyle = CYAN_DIM;
      const ticks = 16;
      for (let i = 0; i < ticks; i++) {
        const angle = (i / ticks) * Math.PI * 2;
        const x1 = cx + Math.cos(angle) * (maxRadius + 1);
        const y1 = cy + Math.sin(angle) * (maxRadius + 1);
        const x2 = cx + Math.cos(angle) * (maxRadius + 5);
        const y2 = cy + Math.sin(angle) * (maxRadius + 5);

        ctxRadial.beginPath();
        ctxRadial.moveTo(x1, y1);
        ctxRadial.lineTo(x2, y2);
        ctxRadial.stroke();
      }

      // --- 2. Scope Vector Generator ---
      const numPoints = 180;

      // Interpolate frequencies: 1.0 (rest circle) <---> 3.0 / 2.0 (active shape)
      const freqX = 1 + (3 - 1) * scopeMorph;
      const freqY = 1 + (2 - 1) * scopeMorph;

      // Visual Styles Interpolation
      const lineAlpha =
        0.25 + idlePulse * 0.45 * (1 - scopeMorph) + scopeMorph * 0.75;
      const glowBlur =
        (4 + idlePulse * 10) * (1 - scopeMorph) +
        (6 + currentPulse * 12) * scopeMorph;

      ctxRadial.strokeStyle = `rgba(51, 255, 204, ${lineAlpha})`;
      ctxRadial.lineWidth =
        (1.0 + idlePulse * 0.5) * (1 - scopeMorph) + 1.6 * scopeMorph;
      ctxRadial.shadowColor = CYAN_MAIN;
      ctxRadial.shadowBlur = glowBlur;

      const beamJitterX = (Math.random() - 0.5) * currentPulse * 6 * scopeMorph;
      const beamJitterY = (Math.random() - 0.5) * currentPulse * 6 * scopeMorph;

      const baseScale = 0.28 * (1 - scopeMorph) + 0.38 * scopeMorph;
      const pulseExpansion =
        1 +
        currentPulse * 0.15 * scopeMorph +
        idlePulse * 0.04 * (1 - scopeMorph);

      ctxRadial.beginPath();
      for (let i = 0; i <= numPoints; i++) {
        const theta = (i / numPoints) * Math.PI * 2;

        const modX =
          Math.sin(theta * freqX + continuousPhase * 1.4) *
          (ampA * maxRadius * 0.42);
        const modY =
          Math.cos(theta * freqY - continuousPhase * 0.9) *
          (ampB * maxRadius * 0.42);

        const baseRadius = maxRadius * baseScale * pulseExpansion;
        const rx = baseRadius + modX;
        const ry = baseRadius + modY;

        const x = cx + Math.cos(theta) * rx + beamJitterX;
        const y = cy + Math.sin(theta) * ry + beamJitterY;

        if (i === 0) ctxRadial.moveTo(x, y);
        else ctxRadial.lineTo(x, y);
      }
      ctxRadial.closePath();
      ctxRadial.stroke();

      // --- 3. Electron Beam Origin Spot ---
      const spotAlpha =
        (0.4 + idlePulse * 0.6) * (1 - scopeMorph) + 1.0 * scopeMorph;
      const spotRadius =
        (1.8 + idlePulse * 1.2) * (1 - scopeMorph) +
        (2 + currentPulse * 2.5) * scopeMorph;

      ctxRadial.fillStyle = `rgba(51, 255, 204, ${spotAlpha})`;
      ctxRadial.shadowColor = CYAN_MAIN;
      ctxRadial.shadowBlur =
        (3 + idlePulse * 8) * (1 - scopeMorph) + 10 * scopeMorph;

      ctxRadial.beginPath();
      ctxRadial.arc(cx, cy, spotRadius, 0, Math.PI * 2);
      ctxRadial.fill();

      ctxRadial.restore();
    };

    const loop = () => {
      phase += isPlaying ? 0.025 : 0.004;
      renderScrubber();
      renderScope();
      requestAnimationFrame(loop);
    };

    loop();

    widget.bind(window.SC.Widget.Events.READY, () => {
      widget.getDuration((d: number) => {
        trackDuration = d;
      });
      widget.getCurrentSound((sound: any) => {
        if (sound) {
          if (titleLink) {
            titleLink.textContent = sound.title.toUpperCase();
            titleLink.href = sound.permalink_url;
          }
          if (sound.waveform_url) {
            fetch(sound.waveform_url.replace(".png", ".json"))
              .then((res) => res.json())
              .then((data) => {
                if (data?.samples?.length) {
                  const max = Math.max(...data.samples);
                  const min = Math.min(...data.samples);
                  const range = max - min || 1;
                  waveformPeaks = data.samples.map(
                    (s: number) => (s - min) / range,
                  );
                  maxTrackPeak = 1;
                }
              })
              .catch((err) =>
                console.error("Failed loading SoundCloud waveform:", err),
              );
          }
        }
      });
    });

    playBtn?.addEventListener("click", () => widget.toggle());

    widget.bind(window.SC.Widget.Events.PLAY, () => {
      isPlaying = true;
      if (playBtn) playBtn.textContent = "> PAUSE <";
    });

    widget.bind(window.SC.Widget.Events.PAUSE, () => {
      isPlaying = false;
      if (playBtn) playBtn.textContent = "> PLAY <";
    });

    widget.bind(window.SC.Widget.Events.PLAY_PROGRESS, (data: any) => {
      if (!isScrubbing) {
        masterProgressRatio = data.relativePosition;
        currentPosMs = data.currentPosition;
        if (timeCurrent) timeCurrent.textContent = formatTime(currentPosMs);
      }
    });

    const handleScrub = (e: MouseEvent) => {
      if (!scrubCanvas) return;
      const rect = scrubCanvas.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      masterProgressRatio = Math.max(0, Math.min(1, clickX / rect.width));
      if (trackDuration) {
        currentPosMs = Math.floor(trackDuration * masterProgressRatio);
        if (timeCurrent) timeCurrent.textContent = formatTime(currentPosMs);
        widget.seekTo(currentPosMs);
      }
    };

    window.addEventListener("keydown", function (event) {
      if (event.code === "Space") {
        event.preventDefault();
        widget.toggle();
      }
    });

    scrubCanvas?.addEventListener("mousedown", (e) => {
      isScrubbing = true;
      handleScrub(e);
    });

    window.addEventListener("mousemove", (e) => {
      if (isScrubbing) handleScrub(e);
    });

    window.addEventListener("mouseup", () => {
      isScrubbing = false;
    });
  };

  if (document.readyState === "complete") setupAudioDeck();
  else window.addEventListener("load", setupAudioDeck);
</script>

<style>
  #sc-hidden-iframe {
    position: fixed !important;
    top: -9999px !important;
    left: -9999px !important;
    width: 0 !important;
    height: 0 !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .audio-deck {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    font-family: var(--machine-text);
    color: var(--glow);
    text-shadow:
      0 0 1px #fff,
      0 0 5px var(--glow),
      0 0 15px var(--glow-dark);
  }

  .radial-stage {
    width: 150px;
    height: 150px;
  }

  .scrubber-stage {
    width: 100%;
    height: 48px;
  }

  #canvas-radial,
  #canvas-scrubber {
    width: 100%;
    height: 100%;
  }

  #canvas-scrubber {
    cursor: crosshair;
  }

  .signal-readout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    gap: 1rem;
    color: var(--glow);
    text-decoration: none;
    white-space: nowrap;
    overflow: visible;
    text-overflow: ellipsis;
  }

  .signal-readout a {
    color: var(--glow);
    font-family: var(--machine-text);
    text-decoration: none;
    white-space: nowrap;
    overflow: visible;
    text-overflow: ellipsis;
    text-shadow:
      0 0 1px #fff,
      0 0 5px var(--glow),
      0 0 15px var(--glow-dark);
  }

  .signal-trigger {
    cursor: pointer;
    user-select: none;
    transition: opacity 0.2s ease;
  }

  .signal-readout a:hover,
  .signal-trigger:hover {
    text-shadow: none;
  }

  .time-code {
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }
</style>
