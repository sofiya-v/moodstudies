---
import SoundCloudPlayer from "../components/SoundCloudPlayer.astro";
import "../styles/global.css";

interface Props {
  studyNumber: string;
  artist: string;
  trackId: string;

  shrineColor?: string;
  shrineFilter?: string;

  trinketSrc: string;
  trinketAlt?: string;

  blueHourSrc: string;
  blueHourAlt?: string;
  blueHourMetadata?: string;

  whiteInkblotSrc: string;
  blackInkblotSrc: string;

  dreamImageSrc: string;
  dreamImageAlt?: string;
  dreamExcerpt?: string;
}

const {
  studyNumber,
  artist,
  trackId,

  shrineColor = "#d4a373",
  shrineFilter = "brightness(1.05) contrast(1.1) sepia(0.15)",

  trinketSrc,
  trinketAlt = "Personal trinket contributed by the artist",

  blueHourSrc,
  blueHourAlt = "Blue-hour photograph contributed by the artist",
  blueHourMetadata = "BLUE HOUR // ARCHIVE RECORD",

  whiteInkblotSrc,
  blackInkblotSrc,

  dreamImageSrc,
  dreamImageAlt = "Image accompanying the dream log",
  dreamExcerpt = "The room is big and then it’s small until it’s big once more.",
} = Astro.props;

const pageTitle = `mood study ${studyNumber} — ${artist}`;

/* Procedural SVG noise texture pattern for backdrop */
const noiseTexturePattern = `data:image/svg+xml;utf8,${encodeURIComponent(`
  <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
    <filter id="noiseFilter">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch"/>
    </filter>
    <rect width="100%" height="100%" filter="url(#noiseFilter)" opacity="0.07"/>
  </svg>
`)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`Mood study ${studyNumber}, featuring ${artist}.`}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>

  <body>
    <div
      class="study-room"
      data-study-shell
      data-study-number={studyNumber}
      style={`--shrine-accent: ${shrineColor}; --shrine-filter: ${shrineFilter}; --noise-bg: url("${noiseTexturePattern}");`}
      aria-label={`Mood study ${studyNumber}: ${artist}`}
    >
      <header class="audio-rail">
        <div class="deck-wrapper">
          <SoundCloudPlayer trackId={trackId} />
        </div>

        <nav class="room-nav" aria-label="Site Navigation">
          <a
            class="machine-link nav-item"
            href="/"
            aria-label="Return to homepage"
          >
            home
          </a>
          <a
            class="machine-link nav-item"
            href="/archive"
            aria-label="Return to archival index"
          >
            index
          </a>
        </nav>
      </header>

      <!-- Room Canvas -->
      <main class="room-canvas">
        <!-- Draggable Blue Hour Rug Window -->
        <div id="blue-hour-dialog" class="shrine-dialog blue-hour-dialog">
          <div class="photo-border">
            <div class="dialog-header-bar">
              <span class="dialog-title-text">blue_hour.png</span>
              <div class="dialog-controls">
                <span class="control-btn"></span>
                <span class="control-btn"></span>
                <span class="control-btn"></span>
              </div>
            </div>
            <div class="dialog-body window-body">
              <div class="window-image-container">
                <img src={blueHourSrc} alt={blueHourAlt} class="window-image" />
              </div>
              <div class="window-sill">
                <span class="metadata">{blueHourMetadata}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 1. Dream Log Panel -->
        <div id="dream-dialog" class="shrine-dialog dream-dialog">
          <div class="photo-border">
            <div class="dialog-header-bar">
              <span class="dialog-title-text">dream_log_{studyNumber}.txt</span>
              <div class="dialog-controls">
                <span class="control-btn"></span>
                <span class="control-btn"></span>
                <span class="control-btn"></span>
              </div>
            </div>
            <div class="dialog-body dream-body">
              <h3 class="dream-header">dream log {studyNumber}</h3>
              <div class="dialog-copy dream-copy">
                <slot name="dream log">
                  <p>{dreamExcerpt}</p>
                </slot>
              </div>
              <figure class="dream-figure">
                <img
                  src={dreamImageSrc}
                  alt={dreamImageAlt}
                  class="dialog-image dream-image"
                />
                <figcaption>
                  <slot name="caption" />
                </figcaption>
              </figure>
            </div>
          </div>
        </div>

        <!-- 2. Interview Window (Scrollable Tapestry) -->
        <div id="interview-dialog" class="shrine-dialog interview-dialog">
          <div class="photo-border">
            <div class="dialog-header-bar">
              <span class="dialog-title-text">interview_plates.dat</span>
              <div class="dialog-controls">
                <span class="control-btn"></span>
                <span class="control-btn"></span>
                <span class="control-btn"></span>
              </div>
            </div>
            <div class="dialog-body interview-body">
              <div class="tapestry-stack">
                <!-- Plate I -->
                <div class="tapestry-section">
                  <div class="inkblot-frame">
                    <img
                      src={blackInkblotSrc}
                      alt="Inkblot Plate I"
                      class="interview-inkblot"
                    />
                  </div>
                  <div class="guest-answer">
                    <slot name="inkblot-1-response">
                      <p>A pair of moths resting on dark granite.</p>
                    </slot>
                  </div>
                </div>

                <!-- Plate II -->
                <div class="tapestry-section">
                  <div class="inkblot-frame">
                    <img
                      src={blackInkblotSrc}
                      alt="Inkblot Plate II"
                      class="interview-inkblot"
                    />
                  </div>
                  <div class="guest-answer">
                    <slot name="inkblot-2-response">
                      <p>Submerged root structures under still water.</p>
                    </slot>
                  </div>
                </div>

                <!-- Plate III -->
                <div class="tapestry-section">
                  <div class="inkblot-frame">
                    <img
                      src={blackInkblotSrc}
                      alt="Inkblot Plate III"
                      class="interview-inkblot"
                    />
                  </div>
                  <div class="guest-answer">
                    <slot name="inkblot-3-response">
                      <p>A doorway opening inward against light.</p>
                    </slot>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Sensory Field Notes Box (Scrollable Tapestry) -->
        <div id="sensory-dialog" class="shrine-dialog sensory-dialog">
          <div class="photo-border">
            <div class="dialog-header-bar">
              <span class="dialog-title-text">field_notes.log</span>
              <div class="dialog-controls">
                <span class="control-btn"></span>
                <span class="control-btn"></span>
                <span class="control-btn"></span>
              </div>
            </div>
            <div class="dialog-body sensory-body">
              <div class="tapestry-stack">
                <div class="tapestry-section">
                  <p class="sensory-question">
                    What is your favorite non-musical sound?
                  </p>
                  <div class="guest-answer">
                    <p>
                      The low, vibrating hum of a refrigerator through a thin
                      apartment wall at 4 AM.
                    </p>
                  </div>
                </div>

                <div class="tapestry-section">
                  <p class="sensory-question">
                    Describe the lighting where you are right now.
                  </p>
                  <div class="guest-answer">
                    <p>
                      Filtered blue morning light refracted through water
                      glasses and floating dust motes.
                    </p>
                  </div>
                </div>

                <div class="tapestry-section">
                  <p class="sensory-question">
                    What recurring motifs do your dreams contain?
                  </p>
                  <div class="guest-answer">
                    <p>
                      Endless subterranean parking garages, flooded basements,
                      and distant radio towers.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 4. Biographical Note / Artist Bio -->
        <div
          id="bio-dialog"
          class="shrine-dialog bio-dialog is-centered active-dialog"
        >
          <div class="photo-border">
            <div class="dialog-header-bar">
              <span class="dialog-title-text">biography.info</span>
              <div class="dialog-controls">
                <span class="control-btn"></span>
                <span class="control-btn"></span>
                <span class="control-btn"></span>
              </div>
            </div>
            <div class="dialog-body">
              <img src={trinketSrc} alt={trinketAlt} class="dialog-offering" />
              <div class="dialog-copy bio-copy">
                <slot name="bio" />
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>

<style>
  :global(:root) {
    --audio-rail-height: 4.75rem;
    color-scheme: dark;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #020000;
  }

  :global(body) {
    color: #ded0c5;
    font-family: Georgia, "Times New Roman", serif;
  }

  :global(button),
  :global(a) {
    font: inherit;
  }

  .study-room {
    position: relative;
    z-index: 1;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;

    background-color: #050000;
    background-image:
      radial-gradient(
        circle at 50% 50%,
        rgba(153, 10, 22, 0.65) 0%,
        rgba(55, 2, 6, 0.92) 45%,
        rgba(4, 0, 1, 0.99) 85%
      ),
      var(--noise-bg);
    background-size:
      cover,
      180px 180px;
    background-position: center, center;
    background-repeat: no-repeat, repeat;
  }

  .room-canvas {
    position: fixed;
    top: var(--audio-rail-height);
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .blue-hour-dialog {
    top: 4.5rem;
    left: 7.5vw;
    width: min(85vw, 20rem);
  }

  .window-image-container {
    position: relative;
    overflow: hidden;
  }

  .window-image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 36dvh;
    object-fit: cover;
    filter: brightness(0.95) contrast(1.15) sepia(0.2);
  }

  .window-sill {
    margin-top: 0.4rem;
    padding: 0.2rem 0.2rem;
    text-align: left;
  }

  .audio-rail {
    position: fixed;
    top: 2rem;
    left: 2rem;
    right: 2rem;
    z-index: 10000;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    pointer-events: none;
  }

  .deck-wrapper {
    pointer-events: auto;
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .room-nav {
    pointer-events: auto;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  :global(.machine-link) {
    color: #ded0c5;
    text-decoration: none;
    font-family: Georgia, serif;
    font-size: 0.88rem;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border: 1px solid rgba(200, 30, 45, 0.4);
    background: rgba(35, 2, 6, 0.9);
    transition: all 200ms ease;
  }

  :global(.machine-link.active),
  :global(.machine-link[aria-current="page"]) {
    color: #1a0509 !important;
    background: #d4a373 !important;
    border-color: #d4a373 !important;
  }

  .shrine-dialog {
    position: absolute;
    margin: 0;
    padding: 0;
    overflow: visible;

    background-color: transparent;
    border: none;
    z-index: 5;

    box-shadow:
      0 55px 75px rgba(0, 0, 0, 0.95),
      0 20px 35px rgba(5, 0, 1, 0.85),
      0 0 50px rgba(220, 15, 30, 0.25);

    pointer-events: auto;
  }

  /* Standard Window Header Bar for normal dialog dragging */
  .dialog-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: #2b080c;
    padding: 6px 10px;
    border-bottom: 1px solid rgba(212, 163, 115, 0.2);
    cursor: grab;
    user-select: none;
  }

  .dialog-header-bar:active {
    cursor: grabbing;
  }

  .dialog-title-text {
    font-family: Georgia, serif;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: #d4a373;
  }

  .dialog-controls {
    display: flex;
    gap: 4px;
  }

  .control-btn {
    width: 8px;
    height: 8px;
    border: 1px solid rgba(212, 163, 115, 0.4);
    background-color: rgba(212, 163, 115, 0.15);
    display: inline-block;
  }

  /* Photo Paper Border */
  .photo-border {
    position: relative;
    padding: 0 0 14px 0;
    background-color: #f7f4ed;
    border: none;
    box-shadow: none;
    overflow: hidden;
  }

  .photo-border::before {
    content: "";
    position: absolute;
    inset: 0;
    top: 28px; /* Offset past the header bar */
    background-color: rgba(165, 12, 22, 0.88);
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 25;
  }

  .shrine-dialog.active-dialog {
    z-index: 100;
    box-shadow:
      0 75px 110px rgba(0, 0, 0, 0.98),
      0 30px 45px rgba(0, 0, 0, 0.9),
      0 0 70px rgba(212, 163, 115, 0.2);
  }

  .dream-dialog {
    top: 5.5rem;
    right: 7vw;
    width: min(94vw, 34rem);
  }

  .interview-dialog {
    top: 16rem;
    left: 27vw;
    width: min(90vw, 31rem);
  }

  .sensory-dialog {
    top: 23rem;
    right: 9vw;
    width: min(90vw, 29rem);
  }

  .bio-dialog {
    top: 4.5rem;
    width: min(90vw, 24rem);
    z-index: 50;
  }

  .bio-dialog.is-centered {
    left: 57%;
    transform: translateX(-50%);
  }

  .dialog-body {
    position: relative;
    z-index: 2;
    max-height: 45dvh;
    padding: 1.25rem 1.1rem 1rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    background-color: #120709;
    color: #ded0c5;
    border: none;
    scrollbar-color: #66222b #120709;
  }

  .window-body {
    padding: 0.5rem;
    background-color: #120709;
    border: none;
  }

  .dialog-image {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 16dvh;
    margin: 0 auto;
    object-fit: contain;
    border: none;
    filter: sepia(0.15) contrast(1.1);
  }

  .dialog-offering {
    display: block;
    width: auto;
    max-width: min(100%, 10rem);
    max-height: 16dvh;
    margin: 0 auto 0.75rem;
    object-fit: contain;
    filter: sepia(0.2);
  }

  .metadata {
    margin: 0.3rem 0 0;
    color: #d4a373;
    font-family: Georgia, serif;
    font-style: italic;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .dream-header {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: 0.9rem;
    color: #d4a373;
    letter-spacing: 0.06em;
    margin: 0 0 0.5rem 0;
  }

  .dream-body {
    display: flex;
    flex-direction: column;
    max-height: 35dvh;
  }

  .dream-figure {
    margin: 0.4rem 0 0;
  }

  .dialog-copy {
    color: #ded0c5;
    font-family: Georgia, serif;
    font-size: 0.92rem;
    line-height: 1.55;
    cursor: text;
    user-select: text;
  }

  .bio-copy {
    margin-top: 0.75rem;
    font-style: italic;
    font-size: 0.88rem;
    color: #c5b2a5;
  }

  .dream-copy {
    width: 100%;
  }

  figcaption {
    margin-top: 0.4rem;
    color: #a89085;
    font-family: Georgia, serif;
    font-style: italic;
    font-size: 0.68rem;
    line-height: 1.4;
  }

  .interview-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.25rem 1rem 1rem;
    text-align: center;
  }

  .tapestry-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  .tapestry-section {
    width: 100%;
  }

  .inkblot-frame {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 7.5rem;
  }

  .interview-inkblot {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 16dvh;
    object-fit: contain;
    filter: contrast(1.1) brightness(0.95) sepia(0.1);
  }

  .sensory-question {
    font-family: Georgia, serif;
    font-size: 0.95rem;
    font-style: italic;
    color: #d4a373;
    margin-bottom: 0.5rem;
    line-height: 1.35;
    text-align: left;
  }

  .guest-answer {
    color: #ded0c5;
    font-family: Georgia, serif;
    font-size: 0.9rem;
    line-height: 1.6;
    text-align: left;
    cursor: text;
    user-select: text;
  }

  @media (max-width: 900px) {
    .shrine-dialog {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      transform: none !important;
      margin: 1.5rem auto;
      width: 92vw !important;
    }

    .room-canvas {
      padding: 1rem;
    }
  }

  @media (max-width: 767px) {
    :global(:root) {
      --audio-rail-height: 4rem;
    }

    .audio-rail {
      top: 1rem;
      left: 1rem;
      right: 1rem;
      gap: 0.5rem;
    }
  }
</style>

<script>
  function initializeStudyShell(shell: HTMLElement) {
    if (shell.dataset.initialized) return;
    shell.dataset.initialized = "true";

    const dialogs = Array.from(
      shell.querySelectorAll<HTMLElement>(".shrine-dialog"),
    );

    const roomCanvas = shell.querySelector<HTMLElement>(".room-canvas");
    const bioDialog = shell.querySelector<HTMLElement>("#bio-dialog");

    if (
      bioDialog &&
      roomCanvas &&
      bioDialog.classList.contains("is-centered")
    ) {
      const centeredLeft = (roomCanvas.clientWidth - bioDialog.offsetWidth) / 2;
      bioDialog.style.left = `${Math.max(0, centeredLeft)}px`;
      bioDialog.classList.remove("is-centered");
    }

    let activeDrag: HTMLElement | null = null;
    let startX = 0;
    let startY = 0;
    let initialLeft = 0;
    let initialTop = 0;
    let activePointerId: number | null = null;

    shell.addEventListener("pointerdown", (event) => {
      const target = event.target as HTMLElement;
      const headerBar = target.closest<HTMLElement>(".dialog-header-bar");
      if (!headerBar) return;

      const dialog = headerBar.closest<HTMLElement>(".shrine-dialog");
      if (!dialog) return;

      dialogs.forEach((d) => d.classList.remove("active-dialog"));
      dialog.classList.add("active-dialog");

      event.preventDefault();

      activeDrag = dialog;
      activePointerId = event.pointerId;

      startX = event.clientX;
      startY = event.clientY;
      initialLeft = dialog.offsetLeft;
      initialTop = dialog.offsetTop;

      dialog.style.left = `${initialLeft}px`;
      dialog.style.top = `${initialTop}px`;
      dialog.style.right = "auto";
      dialog.style.bottom = "auto";
      dialog.style.transform = "none";

      headerBar.setPointerCapture(event.pointerId);
    });

    shell.addEventListener("pointermove", (event) => {
      if (!activeDrag || event.pointerId !== activePointerId) return;

      const dx = event.clientX - startX;
      const dy = event.clientY - startY;

      activeDrag.style.left = `${initialLeft + dx}px`;
      activeDrag.style.top = `${initialTop + dy}px`;
    });

    const stopDrag = (event: PointerEvent) => {
      if (activeDrag && event.pointerId === activePointerId) {
        try {
          (event.target as HTMLElement).releasePointerCapture(event.pointerId);
        } catch (e) {}

        activeDrag = null;
        activePointerId = null;
      }
    };

    shell.addEventListener("pointerup", stopDrag);
    shell.addEventListener("pointercancel", stopDrag);
  }

  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>("[data-study-shell]")
      .forEach(initializeStudyShell);
  });

  document.addEventListener("DOMContentLoaded", () => {
    document
      .querySelectorAll<HTMLElement>("[data-study-shell]")
      .forEach(initializeStudyShell);
  });
</script>
