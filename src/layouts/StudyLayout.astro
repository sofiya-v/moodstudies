---
import BaseLayout from "./BaseLayout.astro";
import SoundCloudPlayer from "../components/SoundCloudPlayer.astro";

interface Props {
  number: string;
  artist: string;
  trackId: string;
  inkblotSrc: string;
  imageSrc: string;
  trinketSrc: string;
  trinketAlt?: string;

  imageAlt?: string;
}

const {
  number,
  artist,
  trackId,
  inkblotSrc,
  imageSrc,
  imageAlt,
  trinketSrc,
  trinketAlt,
} = Astro.props;
const title = `mood study ${number} — ${artist}`;
const isFirst = number === "001";
const isLast = number === "001";
---

<BaseLayout title={title}>
  <header>
    <section class="study-heading">
      <h1>{artist}</h1>
      <SoundCloudPlayer trackId={trackId} />
    </section>
  </header>

  <article>
    <section class="inkblot">
      <h2>•• ━━━━━ what do you see? ━━━━━ ••</h2>
      <img
        src={inkblotSrc}
        alt="Rorschach style inkblot on paper"
        class="inkblot-img"
      />

      <p><slot name="inkblot response" /></p>
    </section>

    <section class="dream">
      <h2>•• ━━━━━ dream log #{number} ━━━━━ ••</h2>
      <p><slot name="dream log" /></p>

      <figure class="dream-img">
        <img src={imageSrc} alt={imageAlt ?? "image"} class="expandable" />
      </figure>
      <figcaption><slot name="caption" /></figcaption>
    </section>

    <section class="bio">
      <p>
        <slot name="bio" />
      </p>
      <img class="trinket" src={trinketSrc} alt={trinketAlt ?? "image"} />
    </section>
  </article>

  <ul class="study-nav">
    <li>
      {
        !isFirst && (
          <a
            onclick={`location.href='/studies/${String(Number(number) - 1).padStart(3, "0")}'`}
          >
            previous
          </a>
        )
      }
    </li>
    <li>
      {
        !isLast && (
          <a
            onclick={`location.href='/studies/${String(Number(number) + 1).padStart(3, "0")}'`}
          >
            next
          </a>
        )
      }
    </li>
  </ul>

  <style>
    header {
      align-items: center;
      margin-top: 5rem;
    }

    .soundcloud-player {
      display: block;
      width: 50%;
      justify-self: center;
      border: 0;
      padding: 0;
    }

    .bio img {
      display: block;
      margin: 0 auto 2rem auto;
      width: 30svw;
      padding: 2rem;
    }

    h2 {
      margin-bottom: 5rem;
      text-align: center;
    }

    article {
      display: flex;
      flex-direction: column;
      gap: 7rem;
      align-items: center;
    }

    .study-cover {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding-block: 4rem;
    }

    .inkblot-img {
      justify-self: center;
    }

    figure {
      margin: 2rem 0;
    }

    figcaption {
      text-align: center;
      font-size: 0.725rem;
      font-family: monospace;
      color: var(--muted);
    }

    .study-nav {
      display: flex;
      justify-content: center;
      margin-top: 4rem;
      gap: 2rem;
      margin-bottom: 10rem;
      list-style: none;
    }

    section {
      margin-bottom: 3rem;
    }

    p {
      line-height: 1.6;
      font-family: monospace;
      justify-content: center;
      color: var(--light);
      font-size: 1.125rem;
      margin: 2rem;
    }

    .bio p {
      text-align: center;
      margin-top: 4rem;
      font-size: clamp(0.9rem, 2vw, 1rem);
      text-shadow: 0 0 2px var(--glow);
      font-family: var(--font-syne-mono);
      margin-bottom: 4rem;
      font-style: italic;
    }

    @media (max-width: 767px) {
      article {
        gap: 3rem;
      }

      .study-cover {
        gap: 1.5rem;
        padding-block: 2rem;
      }

      .study-heading h2 {
        margin: 1.5rem;
      }

      .study-cover p {
        margin: 1.5rem 0;
      }

      p {
        margin: 1.5rem 0;
      }
      .dream > p {
        margin: 1.5rem 0;
        font-size: 1rem;
        line-height: 1.8;
        letter-spacing: 0.01em;
      }
    }

    @media (min-width: 768px) and (hover: hover) {
      .expandable {
        cursor: zoom-in;
      }

      .expandable.is-expanded {
        width: 90vw;
        max-width: 90vw;
        margin-left: 50%;
        transform: translateX(-50%);
        cursor: zoom-out;
      }
    }
  </style>

  <script>
    const expandableImages =
      document.querySelectorAll<HTMLImageElement>(".expandable");

    const desktopOnly = window.matchMedia(
      "(min-width: 768px) and (hover: hover)",
    );

    expandableImages.forEach((image) => {
      image.addEventListener("click", () => {
        if (!desktopOnly.matches) return;

        image.classList.toggle("is-expanded");
      });
    });
  </script>
</BaseLayout>
