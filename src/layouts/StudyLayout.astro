---
import BaseLayout from "./BaseLayout.astro";
import SoundCloudPlayer from "../components/SoundCloudPlayer.astro";

interface Props {
  studyNumber: string;
  artist: string;
  trackId: string;
  blueHourSrc: string;
  blueHourMetadata: string;
  blackInkblotSrc: string;
  whiteInkblotSrc: string;
  dreamImageSrc: string;
  trinketSrc: string;
  trinketAlt?: string;
  dreamImageAlt?: string;
  previousStudyHref?: string;
  nextStudyHref?: string;
  previousStudyNumber?: string;
  nextStudyNumber?: string;
}

const {
  studyNumber,
  artist,
  trackId,
  blueHourSrc,
  blueHourMetadata,
  blackInkblotSrc,
  whiteInkblotSrc,
  dreamImageSrc,
  dreamImageAlt,
  trinketSrc,
  trinketAlt,
  previousStudyHref,
  nextStudyHref,
  previousStudyNumber,
  nextStudyNumber,
} = Astro.props;

const title = `mood study ${studyNumber} — ${artist}`;

const ARROWS = {
  left: "M16,7 H11 V4 H9 V5 H7 V6 H5 V7 H3 V9 H5 V10 H7 V11 H9 V12 H11 V9 H16 Z",
  right:
    "M0,7 H5 V4 H7 V5 H9 V6 H11 V7 H13 V9 H11 V10 H9 V11 H7 V12 H5 V9 H0 Z",
};
---

<BaseLayout title={title}>
  <div class="booklet" data-booklet data-study-number={studyNumber}>
    <section
      id="intro"
      class="booklet-page intro"
      data-booklet-page
      aria-label="Introduction"
    >
      <div class="intro-header">
        <h1>
          {artist}
          <span class="study-label">mood study {studyNumber}</span>
        </h1>
      </div>
      <div class="audio-player">
        <SoundCloudPlayer trackId={trackId} />
      </div>
    </section>

    <section
      id="blue-hour"
      class="booklet-page blue-hour"
      data-booklet-page
      aria-label="Blue hour imagery"
      hidden
    >
      <figure class="blue-hour-fig">
        <img
          src={blueHourSrc}
          alt={`Blue hour imagery for study ${studyNumber}`}
          class="blue-hour-img"
        />
        <figcaption>{blueHourMetadata} / {artist}</figcaption>
      </figure>
    </section>

    <section
      id="rorschach"
      class="booklet-page inkblot"
      data-booklet-page
      aria-label="Inkblot response"
      hidden
    >
      <h1>inkblot {studyNumber}</h1>
      <div class="inkblot-stage">
        <img
          src={blackInkblotSrc}
          alt="black Rorschach style inkblot on paper"
          class="inkblot-img default-img"
        />
        <img
          src={whiteInkblotSrc}
          alt="white Rorschach style inkblot"
          class="inkblot-img hover-img"
        />
      </div>
      <p class="copy"><slot name="inkblot response" /></p>
    </section>

    <section id="dream-log" class="booklet-page dream" data-booklet-page hidden>
      <div class="dream-bg-overlay" aria-hidden="true"></div>

      <div class="dream-content-wrapper">
        <h1>dream log {studyNumber}</h1>
        <div class="copy dream-log-content">
          <slot name="dream log" />
        </div>

        <figure class="dream-fig">
          <img src={dreamImageSrc} alt={dreamImageAlt ?? "image"} />
          <figcaption><slot name="caption" /></figcaption>
        </figure>
      </div>
    </section>

    <section
      id="bio"
      class="booklet-page bio"
      data-booklet-page
      aria-label="Artist biography"
      hidden
    >
      <img class="trinket" src={trinketSrc} alt={trinketAlt ?? "image"} />

      <p class="copy"><slot name="bio" /></p>
    </section>

    <nav class="booklet-controls" aria-label="Booklet pages">
      <button type="button" class="page-button" data-booklet-previous>
        <svg
          class="arrow"
          viewBox="0 0 16 16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d={ARROWS.left}></path>
        </svg>
      </button>

      <button type="button" class="page-button" data-booklet-next>
        <svg
          class="arrow"
          viewBox="0 0 16 16"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d={ARROWS.right}></path>
        </svg>
      </button>

      {
        previousStudyHref && (
          <a href={previousStudyHref} class="page-button" data-study-previous>
            <svg
              class="arrow"
              viewBox="0 0 16 16"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d={ARROWS.left} />
            </svg>
            study {previousStudyNumber}
          </a>
        )
      }

      {
        nextStudyHref && (
          <a href={nextStudyHref} class="page-button" data-study-next>
            study {nextStudyNumber}
            <svg
              class="arrow"
              viewBox="0 0 16 16"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d={ARROWS.right} />
            </svg>
          </a>
        )
      }
    </nav>
  </div>
</BaseLayout>

<style>
  /* --- GLOBAL ROOT SAFETY --- */

  :global(html),
  :global(body) {
    width: 100%;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }

  .booklet {
    box-sizing: border-box;
    position: relative;
    width: 100%;
    min-height: 100dvh;
    overflow-x: hidden;
  }

  /* --- INTRO SECTION --- */

  .intro {
    display: flex;
    flex-direction: column;
    justify-content: flex-start; /* Keep layout top-aligned */
    align-items: center;
    width: min(100%, 44rem);
    height: calc(100dvh - 6rem);
    margin-inline: auto;
    padding: 3rem 0 2rem;
    box-sizing: border-box;
  }

  .intro-header {
    width: 100%;
    margin: 0; /* Keep header strictly at the top */
    box-sizing: border-box;
  }

  /* Style study-label within heading */
  .booklet-page h1 .study-label {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.45em;
    font-weight: normal;
    opacity: 0.5;
    letter-spacing: 0.05em;
    text-transform: lowercase;
  }

  .audio-player {
    width: min(100%, 28rem);
    margin-block: auto; /* Evenly splits space above & below to center player in remaining area */
    margin-inline: auto;
  }

  /* --- BLUE HOUR SECTION --- */

  .blue-hour {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .blue-hour-fig {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .blue-hour-img {
    max-width: 100%;
    max-height: 65vh;
    width: auto;
    height: auto;
    object-fit: contain;

    /* Subtle focus animation on load */
    animation: blue-hour-focus 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: transform, filter, opacity;
  }

  /* Reset animation state when hidden so it re-triggers smoothly on navigation */
  .booklet-page[hidden] .blue-hour-img {
    animation: none;
    opacity: 0;
    filter: blur(12px);
    transform: scale(0.96);
  }

  @keyframes blue-hour-focus {
    0% {
      opacity: 0;
      filter: blur(12px);
      transform: scale(0.96);
    }
    100% {
      opacity: 1;
      filter: blur(0px);
      transform: scale(1);
    }
  }

  /* --- INKBLOT SECTION --- */

  .inkblot-stage {
    position: relative;
    width: 100%;
    max-width: 36rem;
    height: 50vh;
    margin: 3rem auto;
    display: flex;
    align-items: center;
    justify-content: center;

    /* Focus-in animation on section load */
    animation: inkblot-focus 2.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: transform, filter, opacity;
  }

  .inkblot-img {
    position: absolute;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    will-change: opacity;
  }

  /* Base states defined explicitly */
  .inkblot-img.default-img {
    opacity: 1;
    animation: inkblot-transform-out 10s ease-in-out 1.2s forwards;
  }

  .inkblot-img.hover-img {
    opacity: 0;
    animation: inkblot-transform-in 10s ease-in-out 1.2s forwards;
  }

  .inkblot .copy {
    opacity: 0;
    animation: inkblot-text-in 1.8s ease-out 0.8s forwards;
    will-change: opacity, transform;
  }

  /* Reset states when page is hidden */
  .booklet-page[hidden] .inkblot-stage {
    animation: none;
    opacity: 0;
    filter: blur(16px);
    transform: scale(0.92);
  }

  /* Force reset animations without clashing base opacities */
  .booklet-page[hidden] .inkblot-img {
    animation: none;
  }

  /* --- INKBLOT ANIMATION KEYFRAMES --- */

  @keyframes inkblot-focus {
    0% {
      opacity: 0;
      filter: blur(16px);
      transform: scale(0.92);
    }
    100% {
      opacity: 1;
      filter: blur(0px);
      transform: scale(1);
    }
  }

  @keyframes inkblot-transform-out {
    0% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes inkblot-transform-in {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1; /* Guarantees 100% full opacity white image */
    }
  }

  @keyframes inkblot-text-in {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  /* --- DREAM LOG SECTION --- */

  .dream {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    min-height: 160vh;
    margin: 0;
    padding: 3rem 1.5rem 12rem; /* Aligns heading to top 3rem like other pages */
  }

  .dream-bg-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background-color: #000;
    pointer-events: none;
    z-index: 1;

    animation: dim-in 10s ease-out forwards;
  }

  .booklet-page[hidden] .dream-bg-overlay {
    animation: none;
    opacity: 0;
  }

  .dream-content-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .dream-content-wrapper h1 {
    margin: 0 0 3rem 0;
    padding-left: clamp(1.5rem, 8vw, 4.5rem);
    width: 100%;
    text-align: left;
    box-sizing: border-box;
  }

  .dream-log-content {
    width: min(100% - 3rem, 42rem);
    margin-inline: auto;
    box-sizing: border-box;
    animation: dream-text-in 5s ease-out forwards;
  }

  .dream-fig {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: 6rem;
    margin-bottom: 2rem;
    padding-inline: 1.5rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;

    opacity: 0.15;
    filter: blur(20px);
    transform: scale(0.5);
    transform-origin: center center;

    transition:
      opacity 1.4s ease-out,
      filter 1.6s ease-out,
      transform 5s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity, filter;
  }

  .dream-fig.in-view {
    opacity: 1;
    filter: blur(0px);
    transform: scale(1);
  }

  .dream-fig img {
    width: min(100%, 72rem);
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  /* --- BIO SECTION --- */

  .bio {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 2rem 0;
  }

  .bio .trinket {
    display: block;
    width: min(80svw, 40rem);
    max-width: 100%;
    margin: 0 auto 2rem;
    padding: 2rem;
  }

  /* --- GENERAL SECTION --- */

  .booklet-page:not(.dream) {
    box-sizing: border-box;
    width: 100%;
    min-height: 100dvh;
    margin: 0;
    padding: 3rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .booklet-page h1 {
    width: 100%;
    margin: 0 0 auto 0; /* Pushes the heading to the top of the viewport */
    padding-left: clamp(
      1.5rem,
      8vw,
      4.5rem
    ); /* Shifted further right across booklet pages */
    text-align: left;
    box-sizing: border-box;
  }

  figcaption {
    color: var(--muted);
    font-family: monospace;
    font-size: 0.725rem;
    margin-top: 0.5rem;
  }

  .booklet-page[hidden] {
    display: none !important;
  }

  .booklet-controls {
    position: fixed;
    z-index: 9999;
    right: 10rem;
    bottom: 2rem;
    left: 10rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
    align-items: center;
    gap: 1rem;
    padding: 2.5rem 1rem max(1rem, env(safe-area-inset-bottom));

    /* Smooth fade transition */
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.6s ease,
      visibility 0.6s ease;
  }

  /* Hide controls when image is expanded */
  .booklet-controls.hidden-by-image {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .arrow {
    width: 2.5rem;
    height: 2.5rem;
    overflow: visible;
    transition: filter 0.3s ease;
  }

  .arrow path {
    fill: var(--glow);
    transition: fill 0.3s ease;
  }

  .page-button:hover .arrow {
    filter: drop-shadow(0 0 4px rgba(255, 255, 255, 1))
      drop-shadow(0 0 10px rgba(0, 255, 200, 0.8))
      drop-shadow(0 0 10px rgba(0, 255, 200, 0.6))
      drop-shadow(3px 5px 5px rgba(0, 0, 0, 0.7));
  }

  .page-button:hover .arrow path {
    fill: white;
  }

  .page-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    border: 0;
    padding: 0.5rem;
    background: transparent;
    font-family: monospace;
    color: var(--light);
    font-size: clamp(0.8rem, 2vw, 1rem);
    will-change: transform, color, text-shadow;
    transition:
      transform 0.3s ease,
      color 0.3s ease,
      text-shadow 0.3s ease;
    text-transform: uppercase;
    text-decoration: none;
  }

  [data-booklet-previous],
  [data-study-previous] {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
  }

  [data-booklet-next],
  [data-study-next] {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
  }

  .page-button:disabled,
  .page-button[hidden] {
    display: none;
  }

  /* --- ANIMATION KEYFRAMES --- */

  @keyframes dim-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.7;
    }
  }

  @keyframes dream-text-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* --- RESPONSIVE MEDIA QUERIES --- */

  @media (max-width: 767px) {
    .booklet-page {
      padding: 1.25rem;
      padding-bottom: 5rem;
    }

    .booklet-controls {
      right: 1.5rem;
      left: 1.5rem;
    }
  }
</style>

<script>
  function setupDreamImageFocus() {
    const dreamFig = document.querySelector<HTMLElement>(".dream-fig");
    const mainNav = document.querySelector<HTMLElement>(".main-nav");
    const bookletControls =
      document.querySelector<HTMLElement>(".booklet-controls");
    if (!dreamFig) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            dreamFig.classList.add("in-view");
            mainNav?.classList.add("hidden-by-image");
            bookletControls?.classList.add("hidden-by-image");
          } else {
            dreamFig.classList.remove("in-view");
            mainNav?.classList.remove("hidden-by-image");
            bookletControls?.classList.remove("hidden-by-image");
          }
        });
      },
      {
        rootMargin: "0px 0px -20% 0px",
        threshold: 0.2,
      },
    );

    observer.observe(dreamFig);
  }

  setupDreamImageFocus();
  document.addEventListener("astro:page-load", setupDreamImageFocus);

  function initializeBooklet(booklet: HTMLElement) {
    if (booklet.dataset.initialized === "true") return;
    booklet.dataset.initialized = "true";

    const pages = Array.from(
      booklet.querySelectorAll<HTMLElement>("[data-booklet-page]"),
    );
    const previousButton = booklet.querySelector<HTMLButtonElement>(
      "[data-booklet-previous]",
    );
    const nextButton = booklet.querySelector<HTMLButtonElement>(
      "[data-booklet-next]",
    );

    const previousStudyLink = booklet.querySelector<HTMLAnchorElement>(
      "[data-study-previous]",
    );
    const nextStudyLink =
      booklet.querySelector<HTMLAnchorElement>("[data-study-next]");

    let currentPage = 0;

    function showPage(index: number, updateHash = true) {
      currentPage = Math.max(0, Math.min(index, pages.length - 1));

      pages.forEach((page, pageIndex) => {
        const isActive = pageIndex === currentPage;
        page.hidden = !isActive;
        page.setAttribute("aria-hidden", String(!isActive));

        if (isActive) {
          window.scrollTo(0, 0);
          if (updateHash && page.id) {
            history.replaceState(null, "", `#${page.id}`);
          }
        }
      });

      // Reset dream image state when switching pages
      const dreamFig = booklet.querySelector<HTMLElement>(".dream-fig");
      if (dreamFig && pages[currentPage].id !== "dream-log") {
        dreamFig.classList.remove("in-view");
      }

      const isFirstPage = currentPage === 0;
      const isLastPage = currentPage === pages.length - 1;

      if (previousButton) previousButton.disabled = isFirstPage;
      if (nextButton) nextButton.disabled = isLastPage;
      if (previousStudyLink) previousStudyLink.hidden = !isFirstPage;
      if (nextStudyLink) nextStudyLink.hidden = !isLastPage;
    }

    const initialHash = window.location.hash.replace("#", "");
    const hashIndex = pages.findIndex((p) => p.id === initialHash);

    if (hashIndex !== -1) {
      showPage(hashIndex, false);
    } else {
      showPage(0, false);
    }

    window.addEventListener("hashchange", () => {
      const currentHash = window.location.hash.replace("#", "");
      const index = pages.findIndex((p) => p.id === currentHash);
      if (index !== -1) showPage(index, false);
    });

    previousButton?.addEventListener("click", () => showPage(currentPage - 1));
    nextButton?.addEventListener("click", () => showPage(currentPage + 1));

    // Keyboard Arrow Navigation
    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      const isTyping =
        target?.matches("input, textarea, select") || target?.isContentEditable;

      if (isTyping || !booklet.isConnected) return;

      if (event.key === "ArrowLeft") {
        event.preventDefault();
        if (currentPage > 0) {
          showPage(currentPage - 1);
        } else if (previousStudyLink && !previousStudyLink.hidden) {
          previousStudyLink.click();
        }
      }

      if (event.key === "ArrowRight") {
        event.preventDefault();
        if (currentPage < pages.length - 1) {
          showPage(currentPage + 1);
        } else if (nextStudyLink && !nextStudyLink.hidden) {
          nextStudyLink.click();
        }
      }
    });
  }

  function initializePage() {
    document
      .querySelectorAll<HTMLElement>("[data-booklet]")
      .forEach(initializeBooklet);
  }

  initializePage();
  document.addEventListener("astro:page-load", initializePage);
</script>
