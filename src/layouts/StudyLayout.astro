---
import SoundCloudPlayer from "../components/SoundCloudPlayer.astro";
import "../styles/global.css";

interface Props {
  studyNumber: string;
  artist: string;
  trackId: string;

  shrineColor?: string;

  trinketSrc: string;
  trinketAlt?: string;

  blueHourSrc: string;
  blueHourAlt?: string;
  blueHourMetadata?: string;

  whiteInkblotSrc: string;
  blackInkblotSrc: string;

  dreamImageSrc: string;
  dreamImageAlt?: string;
  dreamExcerpt?: string;
}

const {
  studyNumber,
  artist,
  trackId,

  shrineColor = "#b3ffbd",

  trinketSrc,
  trinketAlt = "Personal trinket contributed by the artist",

  blueHourSrc,
  blueHourAlt = "Blue-hour photograph contributed by the artist",
  blueHourMetadata = "BLUE HOUR",

  whiteInkblotSrc,
  blackInkblotSrc,

  dreamImageSrc,
  dreamImageAlt = "Image accompanying the dream log",
  dreamExcerpt = "The room is big and then it’s small until it’s big once more.",
} = Astro.props;

const pageTitle = `mood study ${studyNumber} — ${artist}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`Mood study ${studyNumber}, featuring ${artist}.`}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>

  <body>
    <!-- Background Video Elements -->
    <video autoplay muted loop playsinline preload="auto" class="bg-video-web">
      <source src="/film_opt.mp4" type="video/mp4" />
    </video>
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      class="bg-video-mobile"
    >
      <source src="/film_mobile.mp4" type="video/mp4" />
    </video>

    <!-- Translucent Overlay over Video -->
    <div class="video-overlay" aria-hidden="true"></div>

    <div
      class="study-room"
      data-study-shell
      data-study-number={studyNumber}
      style={`--shrine-accent: ${shrineColor};`}
      aria-label={`Mood study ${studyNumber}: ${artist}`}
    >
      <header class="audio-rail">
        <div class="deck-wrapper">
          <SoundCloudPlayer trackId={trackId} />
        </div>

        <nav class="room-nav" aria-label="Site Navigation">
          <a
            class="machine-link nav-item"
            href="/"
            aria-label="Return to homepage"
          >
            home
          </a>
          <a
            class="machine-link nav-item"
            href="/archive"
            aria-label="Return to archival index"
          >
            index
          </a>
        </nav>
      </header>

      <!-- Interactive Canvas Room -->
      <main class="room-canvas">
        <button
          type="button"
          class="blue-hour-window"
          data-dialog-open="blue-hour-dialog"
          aria-label="Open blue-hour photograph"
        >
          <img src="/images/studies/001/blue_hour_arch.png" alt="" />
        </button>

        <!-- Dream fragment -->
        <button
          type="button"
          class="room-artifact dream-artifact"
          data-dialog-open="dream-dialog"
          aria-label="Open the dream log"
        >
          <span>{dreamExcerpt}</span>
        </button>

        <!-- Interview text artifact -->
        <button
          type="button"
          class="room-artifact interview-artifact"
          data-dialog-open="interview-dialog"
          aria-label="Open inkblot interview"
        >
          INTERVIEW
        </button>

        <!-- Trinket (Bio artifact) -->
        <button
          type="button"
          class="room-artifact trinket-artifact"
          data-dialog-open="bio-dialog"
          aria-label="Examine personal trinket and biographical note"
        >
          <img src={trinketSrc} alt="" />
        </button>

        <!-- Guest offering -->
        <button
          type="button"
          class="room-artifact offering-artifact"
          data-dialog-open="offering-dialog"
          aria-label="Examine the object contributed by the artist"
        >
          <img src={trinketSrc} alt="" />
        </button>
      </main>

      <!-- Dialog Windows -->
      <dialog
        id="blue-hour-dialog"
        class="shrine-dialog blue-hour-dialog"
        aria-labelledby="blue-hour-dialog-title"
      >
        <div class="dialog-bar">
          <span id="blue-hour-dialog-title">BLUE HOUR</span>
          <button
            type="button"
            class="close-button"
            data-dialog-close
            aria-label="Close blue-hour window"
          >
            [X]
          </button>
        </div>
        <div class="dialog-body">
          <img src={blueHourSrc} alt={blueHourAlt} class="dialog-image" />
          <p class="metadata">{blueHourMetadata}</p>
        </div>
      </dialog>

      <!-- 3-Plate Interview Window -->
      <dialog
        id="interview-dialog"
        class="shrine-dialog interview-dialog"
        aria-labelledby="interview-dialog-title"
        data-interview-container
      >
        <div class="dialog-bar">
          <span id="interview-dialog-title"
            >INTERVIEW — INKBLOT EXAMINATION</span
          >
          <button
            type="button"
            class="close-button"
            data-dialog-close
            aria-label="Close interview window"
          >
            [X]
          </button>
        </div>

        <div class="dialog-body interview-body">
          <div class="plate-indicator">
            PLATE <span data-plate-num>I</span> / III
          </div>

          <!-- Plate I -->
          <div class="plate-step" data-plate="1">
            <div class="inkblot-frame">
              <img
                src={blackInkblotSrc}
                alt="Inkblot Plate I"
                class="interview-inkblot"
              />
            </div>
            <div class="response-area" data-response hidden>
              <div class="guest-answer">
                <slot name="inkblot-1-response">
                  <p>A pair of moths resting on dark granite.</p>
                </slot>
              </div>
            </div>
          </div>

          <!-- Plate II -->
          <div class="plate-step" data-plate="2" hidden>
            <div class="inkblot-frame">
              <img
                src={blackInkblotSrc}
                alt="Inkblot Plate II"
                class="interview-inkblot"
              />
            </div>
            <div class="response-area" data-response hidden>
              <div class="guest-answer">
                <slot name="inkblot-2-response">
                  <p>Submerged root structures under still water.</p>
                </slot>
              </div>
            </div>
          </div>

          <!-- Plate III -->
          <div class="plate-step" data-plate="3" hidden>
            <div class="inkblot-frame">
              <img
                src={blackInkblotSrc}
                alt="Inkblot Plate III"
                class="interview-inkblot"
              />
            </div>
            <div class="response-area" data-response hidden>
              <div class="guest-answer">
                <slot name="inkblot-3-response">
                  <p>A doorway opening inward against light.</p>
                </slot>
              </div>
            </div>
          </div>

          <!-- Interactive Controls -->
          <div class="interview-controls">
            <button type="button" class="interview-btn" data-action="reveal">
              REVEAL RESPONSE
            </button>
            <button
              type="button"
              class="interview-btn"
              data-action="next"
              hidden
            >
              NEXT
            </button>
            <button
              type="button"
              class="interview-btn"
              data-action="close"
              data-dialog-close
              hidden
            >
              [ CLOSE INTERVIEW ]
            </button>
          </div>
        </div>
      </dialog>

      <dialog
        id="bio-dialog"
        class="shrine-dialog bio-dialog"
        aria-labelledby="bio-dialog-title"
      >
        <div class="dialog-bar">
          <span id="bio-dialog-title">TRINKET / BIOGRAPHICAL NOTE</span>
          <button
            type="button"
            class="close-button"
            data-dialog-close
            aria-label="Close biographical note"
          >
            [X]
          </button>
        </div>
        <div class="dialog-body">
          <img src={trinketSrc} alt={trinketAlt} class="dialog-offering" />
          <div class="dialog-copy bio-copy">
            <slot name="bio" />
          </div>
        </div>
      </dialog>

      <dialog
        id="offering-dialog"
        class="shrine-dialog bio-dialog"
        aria-labelledby="offering-dialog-title"
      >
        <div class="dialog-bar">
          <span id="offering-dialog-title">ARTIST OFFERING</span>
          <button
            type="button"
            class="close-button"
            data-dialog-close
            aria-label="Close offering window"
          >
            [X]
          </button>
        </div>
        <div class="dialog-body">
          <img src={trinketSrc} alt={trinketAlt} class="dialog-offering" />
        </div>
      </dialog>

      <dialog
        id="dream-dialog"
        class="shrine-dialog dream-dialog"
        aria-labelledby="dream-dialog-title"
      >
        <div class="dialog-bar">
          <span id="dream-dialog-title">DREAM LOG</span>
          <button
            type="button"
            class="close-button"
            data-dialog-close
            aria-label="Close dream log"
          >
            [X]
          </button>
        </div>
        <div class="dialog-body dream-dialog-body">
          <div class="dialog-copy dream-copy">
            <slot name="dream log" />
          </div>
          <figure>
            <img
              src={dreamImageSrc}
              alt={dreamImageAlt}
              class="dialog-image dream-image"
            />
            <figcaption>
              <slot name="caption" />
            </figcaption>
          </figure>
        </div>
      </dialog>
    </div>
  </body>
</html>

<style>
  /* Base variable & reset definitions */
  :global(:root) {
    --audio-rail-height: 4.75rem;
    color-scheme: dark;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #000;
  }

  :global(body) {
    color: var(--light, #fff);
    font-family: Arial, Helvetica, sans-serif;
  }

  :global(button),
  :global(a) {
    font: inherit;
  }

  /* Shared background video rules */
  .bg-video-web,
  .bg-video-mobile {
    position: fixed;
    inset: 0;
    z-index: -2;
    width: 100vw;
    height: 100dvh;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
  }

  .bg-video-mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .bg-video-web {
      display: none;
    }
    .bg-video-mobile {
      display: block;
    }
  }

  .video-overlay {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: 
      /* Optional fine vignette to darken edges like an old lens */
      radial-gradient(
        circle at center,
        rgba(0, 0, 0, 0.4) 0%,
        rgba(0, 0, 0, 0.85) 100%
      ),
      /* Static SVG noise pattern tile */
      url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.35'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 180px 180px;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  /* Main Room Container */
  .study-room {
    position: relative;
    z-index: 1;
    width: 100vw;
    height: 100dvh;
    overflow: hidden;
  }

  .room-canvas {
    position: fixed;
    top: var(--audio-rail-height);
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
  }

  /* Top rail holding player + navigation */
  .audio-rail {
    position: fixed;
    top: 2rem;
    left: 2rem;
    right: 2rem;
    z-index: 10000;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;

    width: auto;
    height: auto;
    padding: 0;

    background: transparent;
    border-bottom: 0;
    pointer-events: none;
  }

  /* Audio player wrapper */
  .deck-wrapper {
    pointer-events: auto;
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
  }

  /* Navigation container */
  .room-nav {
    pointer-events: auto;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* Machine Link active state lock (Permanent Glow per shrine color) */
  :global(.machine-link.active),
  :global(.machine-link[aria-current="page"]) {
    color: #000 !important;
    background: var(--shrine-accent, #33ffcc) !important;
    text-shadow: none !important;
    box-shadow: 0 0 8px var(--shrine-accent, #33ffcc) !important;
  }

  .blue-hour-window {
    position: absolute;
    top: 6%;
    right: 6%;
    z-index: 1;

    display: grid;
    place-items: center;

    width: min(55vw, 42rem);
    max-height: calc(100% - 4rem);
    height: auto;
    padding: 0;
    border: 0;

    background: transparent;
    color: var(--light, #fff);
    cursor: zoom-in;
    transform: none;
  }

  .blue-hour-window img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0.82) saturate(0.92);
  }

  .blue-hour-window:focus-visible {
    outline: 1px dotted var(--shrine-accent, #b3ffbd);
    outline-offset: -0.75rem;
  }

  .room-artifact {
    position: absolute;
    z-index: 3;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .interview-artifact {
    top: 32%;
    left: clamp(1.5rem, 7vw, 8rem);
    padding: 0.4rem 0.75rem;

    border: 1px solid var(--shrine-accent, #b3ffbd);
    background: #000;
    color: var(--shrine-accent, #b3ffbd);

    font-family: var(--machine-text, "VT323", monospace);
    font-size: 1.15rem;
    letter-spacing: 0.12em;

    transition:
      transform 150ms ease,
      background 150ms ease,
      color 150ms ease;
  }

  .interview-artifact:hover,
  .interview-artifact:focus-visible {
    background: var(--shrine-accent, #b3ffbd);
    color: #000;
    transform: translateY(-2px);
  }

  .dream-artifact {
    position: absolute;
    bottom: 10vh;
    left: 5vw;
    top: auto;

    width: min(52rem, 65vw);
    padding: 1.25rem 2rem;

    background: rgba(0, 0, 0, 0.45);
    border-left: 2px solid var(--shrine-accent, #b3ffbd);
    color: var(--light, #fff);

    font-family: Arial, Helvetica, sans-serif;
    font-size: clamp(1.15rem, 2.1vw, 1.6rem);
    font-style: italic;
    line-height: 1.45;
    text-align: left;

    transform: none;
    transition:
      transform 160ms ease-out,
      color 160ly 160ms ease-out,
      border-color 160ms ease-out;
  }

  .dream-artifact:hover,
  .dream-artifact:focus-visible {
    color: var(--shrine-accent, #b3ffbd);
    border-color: var(--shrine-accent, #b3ffbd);
    transform: translateY(-2px);
  }

  .dream-artifact:active {
    transform: translateY(0);
  }

  .trinket-artifact {
    top: 25%;
    right: clamp(1.5rem, 7vw, 8rem);
    width: clamp(8rem, 16vw, 15rem);

    transform: rotate(-3deg);
    transition:
      transform 160ms ease-out,
      filter 160ms ease-out;
  }

  .trinket-artifact img,
  .offering-artifact img {
    display: block;
    width: 100%;
    height: auto;
  }

  .trinket-artifact img {
    filter: drop-shadow(0 10px 12px rgb(0 0 0 / 0.65));
  }

  .trinket-artifact:hover,
  .trinket-artifact:focus-visible {
    transform: translateY(-4px) rotate(-1deg);
    filter: brightness(1.08) drop-shadow(0 14px 16px rgb(0 0 0 / 0.75));
  }

  .trinket-artifact:active {
    transform: translateY(-1px) rotate(-1deg) scale(0.985);
  }

  .offering-artifact {
    right: clamp(1.5rem, 7vw, 8rem);
    bottom: clamp(2.5rem, 8vh, 6rem);
    width: clamp(9rem, 20vw, 19rem);

    transform: rotate(1.5deg);
    transition:
      transform 170ms ease-out,
      filter 170ms ease-out;
  }

  .offering-artifact img {
    filter: drop-shadow(0 13px 14px rgb(0 0 0 / 0.7));
  }

  .offering-artifact:hover,
  .offering-artifact:focus-visible {
    transform: translateY(-5px) rotate(2deg);
    filter: brightness(1.07);
  }

  .offering-artifact:active {
    transform: translateY(-1px) rotate(2deg) scale(0.985);
  }

  /* Dialog System */
  .shrine-dialog {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 2000;

    width: min(90vw, 38rem);
    max-height: calc(100dvh - var(--audio-rail-height) - 2rem);
    margin: 0;
    padding: 0;

    overflow: hidden;
    border: 3px outset #b8b8b8;

    background: #090909;
    color: var(--light, #fff);

    box-shadow:
      0 18px 45px rgb(0 0 0 / 0.8),
      0 0 20px
        color-mix(in srgb, var(--shrine-accent, #b3ffbd) 10%, transparent);

    transform: translate(-50%, -50%);
    cursor: grab;
    user-select: none;
  }

  .shrine-dialog:active {
    cursor: grabbing;
  }
  .shrine-dialog::backdrop {
    display: none;
  }

  .blue-hour-dialog {
    width: min(85vw, 42rem);
  }
  .blue-hour-dialog .dialog-image {
    max-height: 52dvh;
  }
  .dream-dialog {
    width: min(92vw, 52rem);
  }
  .bio-dialog {
    width: min(90vw, 44rem);
  }

  .dialog-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;

    min-height: 2rem;
    padding: 0.25rem 0.5rem;

    border-bottom: 1px solid var(--shrine-accent, #b3ffbd);
    background: #121212;
    color: var(--shrine-accent, #b3ffbd);

    font-family: var(--machine-text, "VT323", monospace);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
  }

  .close-button {
    padding: 0.2rem 0.35rem;
    border: 0;
    background: transparent;
    color: var(--shrine-accent, #b3ffbd);
    font-family: inherit;
    font-size: inherit;
    cursor: pointer;
  }

  .close-button:hover,
  .close-button:focus-visible {
    background: var(--shrine-accent, #b3ffbd);
    color: #000;
    outline: 0;
  }

  .dialog-body {
    max-height: calc(100dvh - var(--audio-rail-height) - 5rem);
    padding: 1rem;

    overflow-y: auto;
    overscroll-behavior: contain;

    background: #090909;
    scrollbar-color: var(--shrine-accent, #b3ffbd) #090909;
  }

  .dialog-image {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 72dvh;
    margin: 0 auto;
    object-fit: contain;
  }

  .dialog-offering {
    display: block;
    width: auto;
    max-width: min(100%, 28rem);
    max-height: 52dvh;
    margin: 0 auto 1rem;

    object-fit: contain;
    filter: drop-shadow(0 15px 16px rgb(0 0 0 / 0.65));
  }

  .metadata {
    margin: 0.75rem 0 0;
    color: var(--muted, #888);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .dialog-copy {
    color: var(--light, #fff);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 1rem;
    line-height: 1.65;
    cursor: text;
    user-select: text;
  }

  .bio-copy {
    margin-top: 1.5rem;
    font-style: italic;
  }

  .dream-copy {
    width: min(100%, 42rem);
    margin-inline: auto;
  }

  .dream-dialog-body figure {
    margin: 2.5rem 0 0;
  }
  .dream-image {
    max-height: none;
  }

  figcaption {
    margin-top: 0.65rem;
    color: var(--muted, #888);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    line-height: 1.4;
  }

  /* Interview Component */
  .interview-dialog {
    width: min(90vw, 36rem);
  }

  .interview-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.25rem;
    text-align: center;
  }

  .plate-indicator {
    margin-bottom: 0.75rem;
    color: color-mix(in srgb, var(--light, #fff) 60%, transparent);
    font-family: var(--machine-text, "VT323", monospace);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }

  .plate-step {
    width: 100%;
  }

  .inkblot-frame {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 14rem;
  }

  .interview-inkblot {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 38dvh;
    object-fit: contain;
  }

  .guest-answer {
    margin-top: 1rem;
    padding-top: 1rem;

    border-top: 1px dashed
      color-mix(in srgb, var(--shrine-accent, #b3ffbd) 40%, transparent);
    color: var(--light, #fff);

    font-family: Arial, Helvetica, sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    text-align: left;
    cursor: text;
    user-select: text;
  }

  .interview-controls {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 1.25rem;
  }

  .interview-btn {
    padding: 0.45rem 1.25rem;

    border: 1px solid var(--shrine-accent, #b3ffbd);
    background: transparent;
    color: var(--shrine-accent, #b3ffbd);

    font-family: var(--machine-text, "VT323", monospace);
    font-size: 1rem;
    letter-spacing: 0.08em;
    cursor: pointer;

    transition:
      background 150ms ease,
      color 150ms ease;
  }

  .interview-btn:hover,
  .interview-btn:focus-visible {
    background: var(--shrine-accent, #b3ffbd);
    color: #000;
  }

  /* Responsive Overrides */
  @media (max-width: 767px) {
    :global(:root) {
      --audio-rail-height: 4rem;
    }

    .audio-rail {
      top: 1rem;
      left: 1rem;
      right: 1rem;
      gap: 0.5rem;
    }

    .blue-hour-window {
      width: 96vw;
      height: 60%;
    }

    .interview-artifact {
      top: 28%;
      left: 0.75rem;
    }

    .trinket-artifact {
      top: 15%;
      right: 0.75rem;
      width: 7.5rem;
    }

    .offering-artifact {
      right: 0.75rem;
      bottom: 4rem;
      width: 9rem;
    }

    .dream-artifact {
      top: calc(40% + 20vh);
      width: 90vw;
    }

    .shrine-dialog {
      top: calc(var(--audio-rail-height) + 0.75rem);
      left: 4vw;

      width: 92vw;
      max-height: calc(100dvh - var(--audio-rail-height) - 1.5rem);

      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .room-artifact,
    .interview-artifact {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  function initializeStudyShell(shell: HTMLElement) {
    if (shell.dataset.initialized) return;
    shell.dataset.initialized = "true";

    let highestZ = 2000;

    // Interview sequence controller
    const interviewContainer = shell.querySelector<HTMLElement>(
      "[data-interview-container]",
    );
    if (interviewContainer) {
      const plates = Array.from(
        interviewContainer.querySelectorAll<HTMLElement>("[data-plate]"),
      );
      const plateNumEl =
        interviewContainer.querySelector<HTMLElement>("[data-plate-num]");
      const revealBtn = interviewContainer.querySelector<HTMLButtonElement>(
        '[data-action="reveal"]',
      );
      const nextBtn = interviewContainer.querySelector<HTMLButtonElement>(
        '[data-action="next"]',
      );
      const closeBtn = interviewContainer.querySelector<HTMLButtonElement>(
        '[data-action="close"]',
      );

      let currentIdx = 0;
      const romanNumerals = ["I", "II", "III"];

      const updateInterviewState = (idx: number, isRevealed: boolean) => {
        currentIdx = idx;
        if (plateNumEl)
          plateNumEl.textContent = romanNumerals[idx] || String(idx + 1);

        plates.forEach((plate, i) => {
          plate.hidden = i !== idx;
          const responseEl =
            plate.querySelector<HTMLElement>("[data-response]");
          if (responseEl) {
            responseEl.hidden = i === idx ? !isRevealed : true;
          }
        });

        if (!isRevealed) {
          if (revealBtn) revealBtn.hidden = false;
          if (nextBtn) nextBtn.hidden = true;
          if (closeBtn) closeBtn.hidden = true;
        } else {
          if (revealBtn) revealBtn.hidden = true;
          if (idx < plates.length - 1) {
            if (nextBtn) nextBtn.hidden = false;
            if (closeBtn) closeBtn.hidden = true;
          } else {
            if (nextBtn) nextBtn.hidden = true;
            if (closeBtn) closeBtn.hidden = false;
          }
        }
      };

      interviewContainer.addEventListener("click", (event) => {
        const btn = (event.target as HTMLElement).closest<HTMLButtonElement>(
          "[data-action]",
        );
        if (!btn) return;

        const action = btn.dataset.action;
        if (action === "reveal") {
          updateInterviewState(currentIdx, true);
        } else if (action === "next") {
          if (currentIdx < plates.length - 1) {
            updateInterviewState(currentIdx + 1, false);
          }
        }
      });

      // Reset to Plate I on close
      const dialog = interviewContainer as HTMLDialogElement;
      dialog.addEventListener("close", () => {
        updateInterviewState(0, false);
      });
    }

    // Handle clicks for open buttons and close buttons
    shell.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;

      const closeBtn = target.closest<HTMLButtonElement>("[data-dialog-close]");
      if (closeBtn) {
        closeBtn.closest<HTMLDialogElement>("dialog")?.close();
        return;
      }

      const openBtn = target.closest<HTMLButtonElement>("[data-dialog-open]");
      if (openBtn) {
        const dialogId = openBtn.dataset.dialogOpen;
        const dialog = dialogId ? document.getElementById(dialogId) : null;

        if (dialog instanceof HTMLDialogElement) {
          if (!dialog.open) dialog.show();
          dialog.style.zIndex = String(++highestZ);
          dialog.querySelector<HTMLElement>("[data-dialog-close]")?.focus();
        }
      }
    });

    // Bring dialog to front on touch/click & handle window dragging
    shell.addEventListener("pointerdown", (event) => {
      const target = event.target as HTMLElement;
      const dialog = target.closest<HTMLDialogElement>("dialog.shrine-dialog");

      if (!dialog) return;

      dialog.style.zIndex = String(++highestZ);

      if (
        target.closest(
          "button, a, input, textarea, select, .dialog-copy, .guest-answer",
        )
      )
        return;

      const rect = dialog.getBoundingClientRect();
      const offsetX = event.clientX - rect.left;
      const offsetY = event.clientY - rect.top;

      dialog.style.transform = "none";
      dialog.style.left = `${rect.left}px`;
      dialog.style.top = `${rect.top}px`;

      const moveWindow = (moveEvent: PointerEvent) => {
        const nextLeft = moveEvent.clientX - offsetX;
        const nextTop = Math.max(76, moveEvent.clientY - offsetY);

        dialog.style.left = `${nextLeft}px`;
        dialog.style.top = `${nextTop}px`;
      };

      const stopWindow = () => {
        window.removeEventListener("pointermove", moveWindow);
        window.removeEventListener("pointerup", stopWindow);
      };

      window.addEventListener("pointermove", moveWindow);
      window.addEventListener("pointerup", stopWindow);
    });

    // Close active topmost dialog on Escape
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const openDialogs = Array.from(
        shell.querySelectorAll<HTMLDialogElement>("dialog[open]"),
      );
      if (!openDialogs.length) return;

      const topDialog = openDialogs.reduce((top, current) =>
        (Number(current.style.zIndex) || 0) > (Number(top.style.zIndex) || 0)
          ? current
          : top,
      );
      topDialog.close();
    });
  }

  function init() {
    document
      .querySelectorAll<HTMLElement>("[data-study-shell]")
      .forEach(initializeStudyShell);
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
