---
import BaseLayout from "./BaseLayout.astro";
import SoundCloudPlayer from "../components/SoundCloudPlayer.astro";

interface Props {
  number: string;
  artist: string;
  trackId: string;
  inkblotSrc: string;
  imageSrc: string;
  imageAlt?: string;
}

const { number, artist, trackId, inkblotSrc, imageSrc, imageAlt } = Astro.props;
const title = `mood study ${number} — ${artist}`;
const isFirst = number === "001";
const isLast = number === "001";
---

<BaseLayout title={title}>
  <button
    onclick="location.href='/archive'"
    slot="header-actions"
    aria-label="Return to archive"
  >
    <span aria-hidden="true">index</span>
  </button>
  <article>
    <header class="study-heading">
      <h1>{artist}</h1>
      <SoundCloudPlayer trackId={trackId} />
    </header>

    <section class="inkblot">
      <h2>what do you see?</h2>
      <img
        src={inkblotSrc}
        alt="Rorschach style inkblot on paper"
        class="inkblot-img expandable"
      />

      <p><i><slot name="inkblot response" /></i></p>
    </section>

    <section class="dream">
      <h2>dream log</h2>
      <p><slot name="dream log" /></p>

      <figure class="dream-img">
        <img src={imageSrc} alt={imageAlt ?? "image"} class="expandable" />
      </figure>
      <figcaption><slot name="caption" /></figcaption>
    </section>
  </article>

  <div class="nav">
    {
      !isFirst && (
        <button
          onclick={`location.href='/studies/${String(Number(number) - 1).padStart(3, "0")}'`}
        >
          previous
        </button>
      )
    }
    {
      !isLast && (
        <button
          onclick={`location.href='/studies/${String(Number(number) + 1).padStart(3, "0")}'`}
        >
          next
        </button>
      )
    }
  </div>
  <footer><p><i><slot name="bio" /></i></p></footer>

  <style>
    header {
      text-align: center;
    }

    h1 {
      text-align: center;
    }

    h2 {
      text-align: center;
      margin-bottom: 5rem;
    }

    article {
      display: flex;
      flex-direction: column;
      gap: 7rem;
    }

    .study-cover {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding-block: 4rem;
    }

    .study-heading {
      display: grid;
      gap: 0.5rem;
    }

    .inkblot-img {
      justify-self: center;
    }

    p {
      font-size: 1.125rem;
      margin: 2rem;
    }

    figure {
      margin: 2rem 0;
    }

    figcaption {
      text-align: center;
      font-size: 0.725rem;
      font-family: monospace;
      color: var(--muted);
    }
    nav {
      display: flex;
      justify-content: center;
      margin-top: 4rem;
      gap: 2rem;
    }

    section {
      margin-bottom: 3rem;
    }

    footer p {
      text-align: center;
      margin-top: 4rem;
      font-size: 0.9rem;
      text-shadow: 0 0 2px var(--glow);
      font-family: var(--font-syne-mono);
      margin-bottom: 4rem;
    }

    @media (max-width: 767px) {
      article {
        gap: 3rem;
      }

      .study-cover {
        gap: 1.5rem;
        padding-block: 2rem;
      }

      .study-heading h2 {
        margin: 1.5rem;
      }

      .study-cover p {
        margin: 1.5rem 0;
      }

      p {
        margin: 1.5rem 0;
      }
      .dream > p {
        margin: 1.5rem 0;
        font-size: 1rem;
        line-height: 1.8;
        letter-spacing: 0.01em;
      }
    }

    @media (min-width: 768px) and (hover: hover) {
      .expandable {
        cursor: zoom-in;
      }

      .expandable.is-expanded {
        width: 90vw;
        max-width: 90vw;
        margin-left: 50%;
        transform: translateX(-50%);
        cursor: zoom-out;
      }
    }
  </style>

  <script>
    const expandableImages =
      document.querySelectorAll<HTMLImageElement>(".expandable");

    const desktopOnly = window.matchMedia(
      "(min-width: 768px) and (hover: hover)",
    );

    expandableImages.forEach((image) => {
      image.addEventListener("click", () => {
        if (!desktopOnly.matches) return;

        image.classList.toggle("is-expanded");
      });
    });
  </script>
</BaseLayout>
