---
import AudioPlayer from "../components/SoundCloudPlayer.astro";
import "../styles/global.css";
import Font from "astro/components/Font.astro";
import DimaShader from "../components/DimaShader.astro";

interface Props {
  studyNumber: string;
  date: string;
  duration: string;
  artist: string;
  trackId: string;
  color: string;
  blueHourSrc: string;
  blueHourCaption: string;
  blueHourAlt: string;
  inkblotSrc: string;
  inkblotResponse: string;
  qResponse1: string;
  qResponse2: string;
  qResponse3: string;
  dreamImageSrc?: string;
  dreamImageAlt?: string;
  trinketSrc?: string;
  trinketAlt?: string;
  bio: string;
  caption?: {
    label?: string;
    author?: string;
    authorUrl?: string;
  };
  shader?: string;
  genre: string;
}
const {
  studyNumber,
  date,
  duration,
  artist,
  trackId,
  color,
  blueHourSrc,
  blueHourCaption,
  blueHourAlt,
  inkblotSrc,
  inkblotResponse,
  qResponse1,
  qResponse2,
  qResponse3,
  dreamImageSrc,
  dreamImageAlt,
  bio,
  caption,
  shader,
  genre,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-syne-mono" preload />
    <meta
      property="og:title"
      content={`mood study ${studyNumber} — ${artist}`}
    />
    <meta
      property="og:description"
      content="field notes from the in-between."
    />
    <meta
      property="og:image"
      content={new URL(blueHourSrc, "https://moodstudies.net").href}
    />
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, "https://moodstudies.net").href}
    />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>study {studyNumber} — {artist}</title>
    <script>
      const images = document.querySelectorAll(".study-figure img");

      images.forEach((img) => {
        img.addEventListener("click", () => {
          if (window.matchMedia("(hover: none)").matches) {
            img.classList.toggle("is-color");
          }
        });
      });
    </script></head
  >
  <body style={`--study-color: ${color};`}>
    <!-- Top Navigation -->
    <header class="top-navigation">
      <nav>
        <a class="machine-link" href="/">home</a>
        <a class="machine-link" href="/archive">index</a>
      </nav>
    </header>
    <div class="opening-layout">
      <!-- Artist and audio -->
      <section class="content-column opening-header">
        <header class="artist-header">
          <h1 class="artist-name">
            {artist}
          </h1>
        </header>
        <div class="audio-wrapper">
          <AudioPlayer trackId={trackId} color={color} />
        </div>
      </section>
    </div>

    <section class="shader-section">
      {shader === "dima" && <DimaShader />}
    </section>

    <!-- Asymmetric Editorial Canvas -->
    <main class="ledger-layout">
      <!-- Blue-hour scene -->
      <aside class="media-column">
        <section class="opening-media">
          <figure class="study-figure hero-figure">
            <img src={blueHourSrc} alt={blueHourAlt} />
            <figcaption style="margin-top: 0.75rem;">
              {blueHourCaption}
            </figcaption>
          </figure>
        </section>
      </aside>
      <!-- Main Narrative Flow -->
      <section class="content-column narrative-column">
        <!-- Interview Deck -->
        <div class="interview-stream copy">
          <div class="question-block">
            <h3>What is your favorite non-musical sound?</h3>
            <p>{qResponse1}</p>
          </div>
          <div class="question-block">
            <h3>What tends to recur in your dreams?</h3>
            <p>{qResponse2}</p>
          </div>
          <div class="question-block">
            <h3>Describe the light where you are right now.</h3>
            <p>{qResponse3}</p>
          </div>
        </div>
      </section>
      <div class="inkblot-block">
        <figure class="study-figure inkblot-figure">
          <img
            src={inkblotSrc}
            alt="Inkblot"
            style="border: 1px solid rgba(255,255,255,0.15); padding: 1rem;"
          />
        </figure>
        <div class="question-block copy">
          <h3>what do you see?</h3>
          <p style="font-size: 0.95rem; opacity: 0.9;">{inkblotResponse}</p>
        </div>
      </div>
      <!-- Prose Monolith -->
      <article
        class="study-prose copy"
        style="border-top: 1px solid rgba(255,255,255,0.15); padding-top: 2.5rem;"
      >
        <h2
          style="font-size: 2rem; letter-spacing: -0.02em; margin-bottom: 2rem;"
        >
          dream log {studyNumber}
        </h2>
        <div class="prose-body" style="font-size: 1.15rem; line-height: 1.85;">
          <slot />
        </div>
      </article>
      {
        dreamImageSrc && (
          <figure class="study-figure dream-image">
            <img src={dreamImageSrc} alt={dreamImageAlt || "Dream Image"} />
            {caption?.label && (
              <figcaption style="margin-top: 1rem;">
                {caption?.label}
                {caption?.authorUrl && (
                  <a
                    href={caption?.authorUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {caption?.author}
                  </a>
                )}
              </figcaption>
            )}
          </figure>
        )
      }
      <footer class="bio copy">
        <p class="bio-text"><i>{bio}</i></p>
      </footer>
    </main>
  </body>
</html>
<style>
  body {
    background-color: black;
  }
  /* Navigation Bar */
  .top-navigation {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 2rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  /* Main 2-Column Ledger Canvas */
  .ledger-layout {
    max-width: 1100px;
    margin: 1rem auto 6rem;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 4.5rem;
    align-items: start;
  }
  /* Left Column Media Anchor */
  .media-column {
    position: sticky;
    top: 2.5rem;
  }
  .media-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .hero-figure img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .audio-wrapper {
    width: 100%;
  }
  /* Right Column Content Stream */
  .content-column {
    display: flex;
    flex-direction: column;
    gap: 4rem; /* Substantial vertical breathing room */
  }
  /* Artist Header Lockup */
  .artist-header {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: clamp(16rem, 40svh, 28rem);
    text-align: center;
  }
  .study-tag {
    font-family: var(--font-syne-mono, monospace);
    font-size: 0.85rem;
    color: var(--muted);
    letter-spacing: 0.05em;
    text-transform: lowercase;
  }
  .artist-name {
    font-family: var(--font-syne-mono, monospace);
    font-size: clamp(2rem, 3vw, 3.5rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 0;
    text-transform: lowercase;
    color: var(--light);
    line-height: 0.92;
    margin: 0;
    overflow-wrap: anywhere;
  }
  /* Interview Stream */
  .interview-stream {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  /* Inline Inkblot Split */
  .inkblot-split {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2rem;
    align-items: start;
  }
  .inkblot-figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
  }
  /* Figures & Image Styling */
  .study-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .inline-figure {
    margin: 2rem 0 1rem;
    width: 100%;
  }
  img:not(.page-bg) {
    width: 100%;
    height: auto;
    display: block;
    filter: contrast(130%) brightness(90%) sepia(80%) hue-rotate(180deg);
    transition: filter 0.3s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    img:not(.page-bg):hover {
      filter: none;
    }
  }

  @media (hover: none) {
    img:not(.page-bg).is-color {
      filter: none;
    }
  }

  .dream-image figcaption {
    width: 100%;
  }

  figcaption {
    color: var(--muted);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.85rem;
    line-height: 1.4;
    text-align: left;
  }
  .question-block h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }
  /* Copy Scoping */
  .copy {
    line-height: 1.7;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--light);
    font-size: 1.05rem;
  }
  .copy h2 {
    margin-top: 1rem;
    margin-bottom: 1.25rem;
  }
  .copy p,
  .copy :global(p) {
    color: var(--light);
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .bio-text {
    font-family: var(--font-syne-mono, monospace);
    font-size: 0.95rem;
    color: var(--muted);
  }
  /* Responsive Mobile */

  /* Layout revision: shared alignment, a smaller side column, varied rhythm. */
  .top-navigation,
  .opening-layout,
  .ledger-layout {
    box-sizing: border-box;
    width: 100%;
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .top-navigation {
    padding-top: 2rem;
    padding-bottom: 1rem;
  }
  .opening-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
    margin-top: 7rem;
    margin-bottom: 8rem;
  }
  .opening-header {
    min-width: 0;
    gap: 0;
  }
  .opening-media {
    min-width: 0;
  }

  .hero-figure {
    width: 100%;
    max-width: 100%;
    margin-left: 0;
  }
  .hero-figure img {
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }
  .audio-wrapper {
    max-width: 100%;
    margin: 2rem 0 0;
    padding: 0;
    align-self: flex-start;
    display: flex;
    justify-content: flex-start;
  }
  .audio-wrapper > :global(:first-child) {
    margin-inline: 0;
    padding-inline: 0;
    width: 100%;
    box-sizing: border-box;
  }
  .ledger-layout {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: 4rem;
    row-gap: 3rem;
    margin-top: 0;
    margin-bottom: 5rem;
  }
  .media-column {
    min-width: 0;
    position: static;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .narrative-column {
    min-width: 0;
    gap: 3rem;
  }
  .ledger-layout > .media-column,
  .ledger-layout > .narrative-column {
    align-self: center;
  }
  .interview-stream {
    gap: 3rem;
  }
  .question-block h3 {
    margin-top: 0.5rem;
  }
  .interview-stream > .question-block:first-child {
    margin-top: 0;
  }
  .interview-stream > .question-block:first-child h3 {
    margin-top: 0;
  }
  .question-block p:last-child {
    margin-bottom: 0;
  }
  .prose-body {
    max-width: 65ch;
  }
  .ledger-layout > .dream-image {
    grid-column: 1 / -1;
    width: 100%;
    margin: 0;
    align-items: center;
  }

  .dream-image img {
    width: 100%;
    height: auto;
  }

  .ledger-layout > .bio {
    grid-column: 1 / -1;
    width: 100%;
    margin: 9rem 0 0;
    text-align: left;
  }

  .bio .bio-text {
    max-width: 40ch;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .inkblot-block {
    grid-column: 1 / -1;
    width: 100%;
    max-width: 760px;
    margin: 5rem auto 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .inkblot-block .inkblot-figure {
    margin: 0;
    width: 100%;
  }
  .inkblot-block img {
    box-sizing: border-box;
    width: 100%;
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
  }
  .inkblot-block h3 {
    margin-top: 0;
  }
  .ledger-layout > .study-prose {
    grid-column: 1 / -1;
    box-sizing: border-box;
    width: 100%;
    max-width: 65ch;
    min-width: 0;
    margin-inline: auto;
    font-size: 1.15rem;
    text-align: left;
  }

  .shader-section {
    box-sizing: border-box;
    width: 100%;
    max-width: 1100px;
    padding: 0 2rem;
    margin: 0 auto 8rem;
  }

  /* Mobile layout */
  @media (max-width: 860px) {
    .study-nav a {
      font-size: 1.15rem;
    }

    .ledger-layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 0 1.5rem;
    }
    .media-column {
      position: static;
    }
    .inkblot-split {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .inkblot-figure img {
      max-width: min(270px, 100%);
    }

    .top-navigation,
    .opening-layout,
    .ledger-layout {
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }
    .ledger-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .media-column {
      position: static;
    }
    .hero-figure {
      max-width: 100%;
    }
    .opening-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      margin-top: 2rem;
      margin-bottom: 3.5rem;
    }
    .ledger-layout > .media-column,
    .ledger-layout > .narrative-column {
      align-self: start;
    }
    .opening-media {
      max-width: 500px;
    }
    .audio-wrapper {
      margin-bottom: 0;
    }
    .narrative-column {
      gap: 2.5rem;
    }
    .artist-header {
      min-height: clamp(12rem, 32svh, 20rem);
    }

    /* A quieter hierarchy for the interview on narrow screens. */
    .interview-stream .question-block h3 {
      font-size: 0.98rem;
    }

    .shader-section {
      padding: 0 1.5rem;
      margin-bottom: 4rem;
    }
  }
  @media (max-width: 768px) {
    .top-navigation {
      gap: 1.6rem;
    }

    .top-navigation a {
      font-size: 1.15rem;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    figcaption a:hover,
    .copy a:hover {
      color: var(--study-color);
    }
  }

  figcaption a:focus-visible,
  .copy a:focus-visible {
    color: var(--study-color);
  }
</style>
