---
import BaseLayout from "./BaseLayout.astro";
import SoundCloudPlayer from "../components/SoundCloudPlayer.astro";

interface Props {
  number: string;
  artist: string;
  trackId: string;
  inkblotSrc: string;
  imageSrc: string;
  imageAlt?: string;
}

const { number, artist, trackId, inkblotSrc, imageSrc, imageAlt } = Astro.props;
const title = `mood study ${number} — ${artist}`;
const isFirst = number === "001";
---

<BaseLayout title={title}>
  <button
    slot="header-actions"
    id="archive-btn"
    class="archive-btn"
    type="button"
    aria-pressed="false"
    aria-label="Return to archive"
    ><a href="/archive"> <span aria-hidden="true">back to archive</span></a>
  </button>
  <body>
    <article>
      <section class="study-cover">
        <header class="study-heading">
          <h2>{artist}</h2>
          <SoundCloudPlayer trackId={trackId} />
        </header>
        <p><slot name="bio" /></p>
      </section>

      <section class="inkblot">
        <h2>what do you see?</h2>
        <figure>
          <img
            src={inkblotSrc}
            alt="image of an inkblot on paper"
            class="inkblot-img"
          />
        </figure>

        <p><slot name="inkblot response" /></p>
      </section>

      <section class="dream">
        <h2>dream log</h2>
        <p><slot name="dream log" /></p>

        <figure class="dream-image">
          <img src={imageSrc} alt={imageAlt ?? "image"} />
        </figure>
        <figcaption><slot name="caption" /></figcaption>
      </section>
    </article>
  </body>
  <footer class="flip">
    {
      !isFirst && (
        <a href={`/studies/${String(Number(number) - 1).padStart(3, "0")}`}>
          previous
        </a>
      )
    }
    <a href={`/studies/${String(Number(number) + 1).padStart(3, "0")}`}>
      next
    </a>
  </footer>
</BaseLayout>

<style>
  .archive-btn {
    padding: 0;
    color: var(--fg);
    background: transparent;
    border: 0;
    cursor: pointer;
    style: none;
  }
  article {
    display: flex;
    flex-direction: column;
    gap: 7rem;
  }

  .study-heading h2 {
    font-size: 2.5rem;
    text-align: center;
    margin: 3rem;
    font-family: monospace;
  }

  .study-cover {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-block: 4rem;
  }

  .study-heading {
    display: grid;
    gap: 0.5rem;
  }

  .study-cover p {
    text-align: center;
    margin: 3rem;
  }

  .inkblot-img {
    justify-self: center;
  }

  p {
    font-family: monospace;
    font-size: 1.125rem;
    margin: 2rem;
  }

  figure {
    margin: 2rem 0;
  }

  figcaption {
    text-align: center;
    font-size: 0.725rem;
    color: var(--muted);
  }
  footer {
    font-size: 0.725rem;
    margin: 1rem;
  }
</style>
