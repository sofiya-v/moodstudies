---
import AudioPlayer from "../components/SoundCloudPlayer.astro";
import "../styles/global.css";

interface Props {
  studyNumber: string;
  date: string;
  duration: string;
  artist: string;
  trackId: string;
  blueHourSrc: string;
  blueHourCaption: string;
  blueHourAlt: string;
  inkblotSrc: string;
  inkblotResponse: string;
  qResponse1: string;
  qResponse2: string;
  qResponse3: string;
  dreamImageSrc?: string;
  dreamImageAlt?: string;
  trinketSrc?: string;
  trinketAlt?: string;
  bio: string;
  caption?: {
    label?: string;
    author?: string;
    authorUrl?: string;
  };
}

const {
  studyNumber,
  date,
  duration,
  artist,
  trackId,
  blueHourSrc,
  blueHourCaption,
  blueHourAlt,
  inkblotSrc,
  inkblotResponse,
  qResponse1,
  qResponse2,
  qResponse3,
  dreamImageSrc,
  dreamImageAlt,
  trinketSrc,
  trinketAlt,
  bio,
  caption,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Study {studyNumber} — {artist}</title>
  </head>

  <body>
    <nav>
      <a class="machine-link" href="/">home</a>
      <a class="machine-link" href="/archive">index</a>
    </nav>

    <main class="study-page">
      <header class="study-header">
        <h1>{artist}</h1>
      </header>

      <div class="study-grid">
        <section class="study-audio">
          <AudioPlayer trackId={trackId} />
        </section>

        <figure class="blue-hour">
          <img src={blueHourSrc} alt={blueHourAlt} />
          <figcaption>{blueHourCaption}</figcaption>
        </figure>

        <figure class="inkblot">
          <img src={inkblotSrc} alt="Inkblot" />
          <p>{inkblotResponse}</p>
        </figure>

        <div class="questions">
          <h3>What is your favorite non-musical sound?</h3>
          <p>{qResponse1}</p>

          <h3>What tends to recur in your dreams?</h3>
          <p>{qResponse2}</p>

          <h3>Describe the light where you are right now.</h3>
          <p>{qResponse3}</p>
        </div>

        <article class="study-prose">
          <slot />
        </article>

        <figure class="dream-image">
          <img src={dreamImageSrc} alt={dreamImageAlt} />
        </figure>

        <section class="bio">
          <p>{bio}</p>
        </section>
      </div>
    </main>
  </body>
</html>

<style>
  body {
    background-image: url("/grain_static_bg.jpg");
    background-size: cover;
    background-position: center;
    background-attachment: fixed;

    margin: 0;
    min-height: 100vh;
    padding: 4rem 2rem;
  }

  .study-page {
    max-width: 900px;
    margin: 0 auto;

    background-color: var(--dark);
    padding: 3rem;

    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .study-grid {
    display: grid;
    grid-template-columns: 1fr 1fr; /* 2-column setup */
    gap: 2rem;
    align-items: start;
  }

  .audio-wrapper {
    width: 100%;
    max-width: 600px; /* Adjust to fit your desired layout width */
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .questions {
    grid-column: 1 / -1;
  }
</style>
