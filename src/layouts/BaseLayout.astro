---
interface Props {
  title?: string;
  summary?: string;
}

const { title = "mood studies", summary = "The blue hour is now" } =
  Astro.props;
const isHome = Astro.url.pathname === "/";
const isArchive =
  Astro.url.pathname === "/archive" || Astro.url.pathname === "/";

import "../styles/global.css";
import Font from "astro/components/Font.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-syne-mono" preload />
    <Font cssVariable="--font-silkscreen" preload />
    <Font cssVariable="--font-vt323" preload />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="{title}" />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content="https://moodstudies.net" />
    <title>{title}</title>
  </head>

  <body>
    <video autoplay muted loop playsinline preload="none" class="bg-video-web">
      <source src="/film_opt.mp4" type="video/mp4" />
    </video>
    <video
      autoplay
      muted
      loop
      playsinline
      preload="none"
      class="bg-video-mobile"
    >
      <source src="/film_mobile.mp4" type="video/mp4" />
    </video>
    <nav class="main-nav">
      {
        !isHome && (
          <>
            <a
              class:list={[
                "nav-button nav-home",
                { active: Astro.url.pathname === "/" },
              ]}
              aria-current={Astro.url.pathname === "/" ? "page" : undefined}
              href="/"
            >
              home
            </a>
            <a
              class:list={[
                "nav-button nav-archive",
                { active: Astro.url.pathname === "/archive" },
              ]}
              aria-current={
                Astro.url.pathname === "/archive" ? "page" : undefined
              }
              href="/archive"
            >
              index
            </a>
          </>
        )
      }
    </nav>

    <main>
      <slot />
    </main>
  </body>
</html>
<style>
  .bg-video-web {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    object-fit: cover;
    object-position: center;
    z-index: -1;
    pointer-events: none;
  }

  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow-x: hidden;
  }

  .bg-video-mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .bg-video-web {
      display: none;
    }
    .bg-video-mobile {
      display: block;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      object-fit: cover;
      object-position: center;
      z-index: -1;
      pointer-events: none;
    }
  }

  .nav-button {
    text-decoration: none;
    color: var(--dark);
    padding: 8px 16px;
    background-color: var(--glow);
    transition: background 0.3s;
    font-size: 1.2rem;
    text-transform: uppercase;
    font-family: var(--machine-text);
    letter-spacing: 0.08em;
    border: 3px outset #c0c0c0;
    text-align: center;
  }

  .nav-button:hover {
    background-color: var(--glow-dark);
    text-shadow: none;
    color: var(--dark);
  }

  .nav-button.active {
    border-style: inset;
    transform: translateY(2px);
  }

  .nav-home {
    grid-column: 1;
    justify-self: start;
  }

  .nav-archive {
    grid-column: 2;
    justify-self: end;
  }
</style>
