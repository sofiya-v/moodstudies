---
import "../styles/global.css";

import Font from "astro/components/Font.astro";
interface Props {
  title?: string;
  summary?: string;
  ogTitle?: string;
  ogImage?: string;
}

const {
  title = "mood studies",
  summary = "field notes from the in-between.",
  ogTitle,
  ogImage,
} = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isArchive = pathname.startsWith("/archive");
const shareTitle = ogTitle ?? (isHome ? "the blue hour is now" : title);
const shareImage = new URL(ogImage ?? "/og-home.jpeg", Astro.url.origin).href;
const canonicalUrl = new URL(pathname, Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-syne-mono" preload />
    <Font cssVariable="--font-silkscreen" preload />
    <Font cssVariable="--font-vt323" preload />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={summary} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={summary} />
    <meta name="twitter:image" content={shareImage} />
    <script async src="https://tally.so/widgets/embed.js"></script>
    <title>{title}</title>
  </head>

  <body>
    <video autoplay muted loop playsinline preload="auto" class="bg-video-web">
      <source src="/film_opt.mp4" type="video/mp4" />
    </video>
    <!-- Mobile: original widescreen film over a soft, dark extension. -->
    <div
      class:list={[
        "mobile-film",
        {
          "mobile-film--home": isHome,
          "mobile-film--interior": !isHome,
          "mobile-film--archive": isArchive,
        },
      ]}
      aria-hidden="true"
    >
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        class="mobile-film-glow"
      >
        <source src="/film_opt.mp4" type="video/mp4" />
      </video>
      {
        isHome && (
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            class="mobile-film-original"
          >
            <source src="/film_opt.mp4" type="video/mp4" />
          </video>
        )
      }
    </div>

    <header
      class:list={[
        "top-rail",
        { "top-rail--observatory": pathname.startsWith("/observatory") },
      ]}
    >
      <div class="rail-left">
        <slot name="header-left" />
      </div>

      <nav aria-label="Site Navigation">
        {
          !isHome && (
            <>
              <a
                class:list={[
                  "machine-link nav-item",
                  { active: pathname === "/" },
                ]}
                aria-current={pathname === "/" ? "page" : undefined}
                href="/"
              >
                home
              </a>
              <a
                class:list={[
                  "machine-link nav-item",
                  { active: pathname.startsWith("/archive") },
                ]}
                aria-current={
                  pathname.startsWith("/archive") ? "page" : undefined
                }
                href="/archive"
              >
                index
              </a>
              <a
                class:list={[
                  "machine-link nav-item",
                  { active: pathname.startsWith("/observatory") },
                ]}
                aria-current={
                  pathname.startsWith("/observatory") ? "page" : undefined
                }
                href="/observatory"
              >
                observatory
              </a>
            </>
          )
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow-x: hidden;
  }

  @media (max-width: 768px) {
    .top-rail {
      top: 1.5rem;
      left: 1.25rem;
      right: 1.25rem;
      width: auto;
      transform: none;
    }
  }

  /* Observatory only: inset both mobile header rows from the viewport edge. */
  @media (max-width: 768px) {
    .top-rail--observatory {
      box-sizing: border-box;
      left: 0;
      right: 0;
      width: 100%;
      max-width: none;
      margin: 0;
      padding-inline: 1.5rem;
      transform: none;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .top-rail--observatory .rail-left {
      width: 100%;
      min-width: 0;
    }

    .top-rail--observatory nav {
      width: 100%;
      min-width: 0;
      flex-wrap: wrap;
      justify-content: flex-start;
    }
  }

  .rail-left {
    pointer-events: auto;
    display: flex;
    align-items: center;
  }

  /* Keep the existing desktop background unchanged. */
  .bg-video-web {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    object-fit: cover;
    object-position: center;
    z-index: -1;
    pointer-events: none;
  }

  .mobile-film {
    display: none;
  }

  @media (max-width: 768px) {
    main {
      padding-top: 5rem;
    }

    .bg-video-web {
      display: none;
    }

    .mobile-film {
      display: block;
      position: fixed;
      inset: 0;
      overflow: hidden;
      background: #000;
      z-index: -1;
      pointer-events: none;
    }

    .mobile-film-glow {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: blur(70px) brightness(0.7);
      transform: scale(1.3);
    }

    .mobile-film-original {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: contain;
      transform: translate(-50%, -50%);
      -webkit-mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        black 25%,
        black 75%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        black 25%,
        black 75%,
        transparent 100%
      );
    }

    /* Archive only: more visible chromatic film on mobile. */
    .mobile-film--archive .mobile-film-glow {
      filter: blur(35px) brightness(0.7) saturate(1.5);
      transform: scale(1.15);
    }
  }
</style>
