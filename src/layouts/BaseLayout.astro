---
interface Props {
  title?: string;
}

const { title = "mood studies" } = Astro.props;
const isHome = Astro.url.pathname === "/";

import "../styles/global.css";
import Font from "astro/components/Font.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-syne-mono" preload />
    <Font cssVariable="--font-silkscreen" preload />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>

  <body>
    <video autoplay muted loop playsinline preload="none" class="bg-video-web">
      <source src="/film_opt.mp4" type="video/mp4" />
    </video>
    <video
      autoplay
      muted
      loop
      playsinline
      preload="none"
      class="bg-video-mobile"
    >
      <source src="/film_mobile.mp4" type="video/mp4" />
    </video>
    <header class="site-header">
      {!isHome && <button onclick="location.href='/'">home</button>}

      <div class="site-header-actions">
        <slot name="header-actions" />
      </div>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>
<style>
  .site-header {
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .bg-video-web {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    pointer-events: none;
  }

  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow-x: hidden;
  }

  main {
    position: relative;
  }

  .bg-video-mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .bg-video-web {
      display: none;
    }
    .bg-video-mobile {
      display: block;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      object-fit: cover;
      object-position: center;
      z-index: 0;
      pointer-events: none;
      mix-blend-mode: screen;
    }
  }
</style>
