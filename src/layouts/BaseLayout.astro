---
interface Props {
  title?: string;
  summary?: string;
}

const { title = "mood studies", summary = "The blue hour is now" } =
  Astro.props;
const isHome = Astro.url.pathname === "/";
const isArchive =
  Astro.url.pathname === "/archive" || Astro.url.pathname === "/";

import "../styles/global.css";
import Font from "astro/components/Font.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-syne-mono" preload />
    <Font cssVariable="--font-silkscreen" preload />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="{title}" />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content="https://moodstudies.net" />
    <title>{title}</title>
  </head>

  <body>
    <video autoplay muted loop playsinline preload="none" class="bg-video-web">
      <source src="/film_opt.mp4" type="video/mp4" />
    </video>
    <video
      autoplay
      muted
      loop
      playsinline
      preload="none"
      class="bg-video-mobile"
    >
      <source src="/film_mobile.mp4" type="video/mp4" />
    </video>
    <nav class="main-nav">
      {
        !isHome && (
          <a class="nav-button nav-home" href="/">
            home
          </a>
        )
      }
      {
        !isArchive && (
          <a class="nav-button nav-archive" href="/archive">
            index
          </a>
        )
      }
    </nav>

    <main>
      <slot />
    </main>
  </body>
</html>
<style>
  .bg-video-web {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    object-fit: cover;
    object-position: center;
    z-index: -1;
    pointer-events: none;
  }

  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
    overflow-x: hidden;
  }

  .bg-video-mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .bg-video-web {
      display: none;
    }
    .bg-video-mobile {
      display: block;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      object-fit: cover;
      object-position: center;
      z-index: -1;
      pointer-events: none;
    }
  }
</style>
