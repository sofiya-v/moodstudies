---
interface Props {
  title?: string;
}

const { title = "mood studies" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <header>
        <a href="/">mood studies</a>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>